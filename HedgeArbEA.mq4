//+------------------------------------------------------------------+
//|                                                 HedgeArbEA.mq4  |
//|                 双平台报价价差对冲套利 EA（MT4，本地文件通信）     |
//+------------------------------------------------------------------+
#property strict
#property copyright "Generated by AI"
#property link      ""
#property version   "1.00"
#property description "双经纪商 MT4 对冲套利：一边多、一边空，通过公共文件夹通信。"

//--- 输入参数
// 逻辑品种（用于文件名和主控通信，A/B 两端必须一致，例如统一用 "GOLD"）
input string   InpSymbol          = "EURUSD";   // 逻辑品种名（文件名的一部分，主控用这个识别）
// 实际交易品种（本终端 MT4 平台中的真实符号，例如 A 端 GLDUSD，B 端 XAUUSD）
input string   InpTradeSymbol     = "EURUSD";   // 实际交易品种（用于 MarketInfo / OrderSend / OrderClose）
input double   InpMyLots          = 1.0;        // 本终端手数（根据经纪商标准设置，A和B可以不同）
input int      InpThresholdPips   = 5;          // 开仓触发点差（|Bid_B - Ask_A| 或 |Bid_A - Ask_B| 的绝对值，单位：点）
input int      InpStopLossPips    = 15;         // 止损阈值（价差绝对值发散超过此值则止损，单位：点）
input double   InpCloseProfitUSD  = 10.0;       // 平仓条件：A+B 合计盈利 >= 多少美元
input string   InpBrokerId        = "A";        // 本终端标识（例如：A / B）
input bool     InpIsMaster        = true;       // 是否为主控端（必须有一个为 true，一个为 false）
input int      InpMagic           = 20251126;   // EA Magic Number
input int      InpSlippage        = 3;          // 最大允许滑点（点）
input int      InpCheckIntervalMs = 50;         // 检查周期（毫秒）
input bool     InpUseTimer        = false;      // 使用定时器模式（周末测试用，市场开盘时设为 false）

//--- 常量 & 文件名基准
string g_priceFilePrefix   = "ArbPrice_";   // 报价文件前缀
string g_stateFilePrefix   = "ArbState_";   // 状态/指令文件前缀

//--- 运行时变量
datetime g_lastCheckTime = 0;
int      g_lastTickTimeMs = 0;
int      g_timerId = -1;
string   g_lastExecutedCommand = "";  // 记录最后执行的指令，避免重复执行
datetime g_lastFailedOpenTime = 0;    // 记录最后一次两边都失败的时间（用于防止立即重试）
datetime g_lastCommandSendTime = 0;   // 记录最后一次发送指令的时间（用于超时检测）
string   g_lastCommandSent = "";      // 记录最后一次发送的指令内容
double   g_openDiff = 0.0;            // 记录开仓时的价差（用于止损计算）
double   g_lastDiff = 0.0;            // 记录上一次的价差（用于判断价差是否持续扩大）

//--- 工具函数声明
double   GetPointPip();
string   GetPriceFileName(const string brokerId);
string   GetStateFileName();
bool     WriteMyPrice();
bool     WriteMyAccountInfo();
bool     WriteMyPositions();
bool     WriteTradeHistory();
bool     ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB);
bool     ReadBothBidAsk(double &bidA, double &askA, double &bidB, double &askB, bool &haveA, bool &haveB);
bool     ReadAccountLots(const string brokerId, double &lots);
bool     IsMyBrokerA();
bool     HaveOpenHedgePositions();
void     CheckAndOpenHedge();
void     CheckAndCloseHedge();
double   CalcMyProfitPips();
double   CalcMyProfitUSD();
bool     WriteMyProfit(double profitPips);
bool     WriteMyProfitUSD(double profitUSD);
bool     ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB);
bool     ReadBothProfitsUSD(double &profitA, double &profitB, bool &haveA, bool &haveB);
void     ExecCommands();
void     SendCommand(const string cmd);
void     WriteCommandAck(const string cmdLine);
bool     CheckBothAcked(const string cmdLine);
void     CleanupCompletedCommands();
void     CheckAndCancelFailedOpen(const string cmdLine);
void     CheckAndHandleFailedClose(const string cmdLine);
void     ClearCommandFile();
bool     CheckOtherSideFailed(const string cmdLine);
bool     CheckOtherSideSucceeded(const string cmdLine);
void     CloseAllMyPositions();
void     CloseAllMyPositionsWithRetry();

//+------------------------------------------------------------------+
//| EA 初始化                                                         |
//+------------------------------------------------------------------+
int OnInit()
  {
   if(StringLen(InpBrokerId) <= 0)
     {
      Print("错误：请在参数中设置 InpBrokerId（例如 A 或 B）");
      return(INIT_FAILED);
     }

   if(InpMyLots <= 0)
     {
      Print("错误：手数 InpMyLots 必须大于 0");
      return(INIT_FAILED);
     }

   if(Symbol() != InpTradeSymbol)
      Print("警告：当前图表品种(", Symbol(), ") 与参数 InpTradeSymbol(", InpTradeSymbol, ") 不一致，将按 InpTradeSymbol 交易。");

   Print("HedgeArbEA 初始化完成。BrokerId=", InpBrokerId,
         " IsMaster=", (InpIsMaster ? "true" : "false"),
         " LogicalSymbol=", InpSymbol,
         " TradeSymbol=", InpTradeSymbol,
         " UseTimer=", (InpUseTimer ? "true" : "false"));

   // 如果启用定时器模式，创建定时器（用于周末测试）
   if(InpUseTimer)
     {
      // 计算定时器间隔（秒），确保至少1秒
      int timerSeconds = (int)MathMax(1, InpCheckIntervalMs / 1000.0);
      if(timerSeconds < 1) timerSeconds = 1; // 双重保险，至少1秒
      
      Print("准备创建定时器：InpCheckIntervalMs=", InpCheckIntervalMs, "ms, 转换为秒=", timerSeconds);
      
      g_timerId = EventSetTimer(timerSeconds);
      if(g_timerId == -1)
        {
         int error = GetLastError();
         Print("【错误】定时器创建失败，错误代码=", error, " 尝试的间隔=", timerSeconds, "秒");
        }
      else
        {
         Print("【成功】定时器模式已启用，每 ", timerSeconds, " 秒执行一次，TimerId=", g_timerId);
         // 不在OnInit中立即执行，避免初始化时阻塞，等待定时器触发
         Print("【提示】EA将在定时器触发时开始执行（首次执行将在 ", timerSeconds, " 秒后）");
        }
     }
   else
     {
      Print("【提示】未启用定时器模式，EA 将在市场有 Tick 时执行（周末市场休市时不会执行）");
      Print("【提示】如需周末测试，请将 InpUseTimer 设置为 true");
     }

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| EA 去初始化                                                       |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   // 删除定时器
   if(g_timerId != -1)
     {
      EventKillTimer();
      g_timerId = -1;
     }
   Print("HedgeArbEA 结束，BrokerId=", InpBrokerId);
  }

//+------------------------------------------------------------------+
//| 每个 Tick 调用                                                   |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 如果使用定时器模式，OnTick 不执行（由 OnTimer 执行）
   if(InpUseTimer)
      return;

   // 控制检查频率，避免 CPU 占用过高
   uint millis = GetTickCount();
   if((int)(millis - g_lastTickTimeMs) < InpCheckIntervalMs)
      return;
   g_lastTickTimeMs = (int)millis;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 定时器事件（用于周末测试）                                        |
//+------------------------------------------------------------------+
void OnTimer()
  {
   if(!InpUseTimer)
      return;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 主要逻辑（从 OnTick 和 OnTimer 调用）                            |
//+------------------------------------------------------------------+
void ExecuteMainLogic()
  {
   static int execCount = 0;
   execCount++;
   
   // 每10次输出一次调试信息
   if(execCount % 10 == 1)
     {
      Print("ExecuteMainLogic 执行 #", execCount, " BrokerId=", InpBrokerId, " UseTimer=", (InpUseTimer ? "true" : "false"));
     }

   // 写入自己的报价
   WriteMyPrice();
   
   // 写入账户信息
   WriteMyAccountInfo();
   
   // 写入持仓信息
   WriteMyPositions();
   
   // 写入交易历史（每10次执行一次，避免过于频繁）
   static int historyWriteCount = 0;
   historyWriteCount++;
   if(historyWriteCount % 10 == 0)
     {
      WriteTradeHistory();
     }

   // 响应来自主控端的指令（开仓/平仓）
   ExecCommands();

   // 所有终端：如果有持仓，写入当前盈亏（用于平仓判断）
   if(HaveOpenHedgePositions())
     {
      double myPips = CalcMyProfitPips();
      WriteMyProfit(myPips);
      // 同时写入盈亏金额（美元）
      double myProfitUSD = CalcMyProfitUSD();
      WriteMyProfitUSD(myProfitUSD);
     }

   // 主控端负责：判断是否开仓 & 是否平仓 & 清理已完成的指令
   if(InpIsMaster)
     {
      // 检查并清理已完成的指令
      CleanupCompletedCommands();
      
      CheckAndOpenHedge();
      CheckAndCloseHedge();
     }
  }

//+------------------------------------------------------------------+
//| 获得“1 点”对应的价格增量（有的品种 Point 是 0.00001，则 1 点=10*Point）|
//+------------------------------------------------------------------+
double GetPointPip()
  {
   // 通常 3/5 位小数的货币对：1 点 = 10 * Point
   if(Digits == 3 || Digits == 5)
      return(Point * 10);
   // 其他情况直接按 1 Point 作为 1 点（黄金等2位小数的品种：1点=0.01）
   return(Point);
  }

//+------------------------------------------------------------------+
//| 根据 BrokerId 生成报价文件名（公共文件夹）                       |
//+------------------------------------------------------------------+
string GetPriceFileName(const string brokerId)
  {
   string name = g_priceFilePrefix + InpSymbol + "_" + brokerId + ".csv";
   return(name);
  }

//+------------------------------------------------------------------+
//| 状态/指令文件名                                                  |
//+------------------------------------------------------------------+
string GetStateFileName()
  {
   string name = g_stateFilePrefix + InpSymbol + ".txt";
   return(name);
  }

//+------------------------------------------------------------------+
//| 写入本终端报价到公共文件夹                                      |
//+------------------------------------------------------------------+
bool WriteMyPrice()
  {
   // 确保品种在市场中可用（如果不在，添加到市场观察窗口）
   if(!SymbolSelect(InpTradeSymbol, true))
     {
      Print("警告：无法选择品种 ", InpTradeSymbol, "，尝试继续获取报价");
     }
   
   // 刷新市场数据以获取实时报价
   RefreshRates();
   
   // 使用 SymbolInfoDouble 获取实时报价（比 MarketInfo 更可靠，自动获取最新报价）
   double bid = SymbolInfoDouble(InpTradeSymbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(InpTradeSymbol, SYMBOL_ASK);
   
   // 如果 SymbolInfoDouble 失败或返回0，回退到 MarketInfo
   if(bid <= 0 || ask <= 0)
     {
      RefreshRates(); // 再次刷新
      bid = MarketInfo(InpTradeSymbol, MODE_BID);
      ask = MarketInfo(InpTradeSymbol, MODE_ASK);
     }
   
   // 调试信息
   static int writeCount = 0;
   writeCount++;
   if(writeCount % 10 == 1) // 每10次输出一次，避免日志过多
     {
      Print("WriteMyPrice 调用 #", writeCount, " TradeSymbol=", InpTradeSymbol, " Bid=", bid, " Ask=", ask);
     }
   
   if(bid <= 0 || ask <= 0)
     {
      Print("警告：报价无效 Bid=", bid, " Ask=", ask);
      return(false);
     }

   string fileName = GetPriceFileName(InpBrokerId);
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开报价文件失败：", fileName, " 错误代码=", error);
      Print("公共文件夹路径检查：FILE_COMMON 标志已使用");
      return(false);
     }

   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(bid, Digits), DoubleToString(ask, Digits));
   FileClose(handle);
   
   if(writeCount % 10 == 1)
     {
      Print("报价文件写入成功：", fileName);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端账户信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyAccountInfo()
  {
   // 确保品种在市场中可用（如果不在，添加到市场观察窗口）
   if(!SymbolSelect(InpTradeSymbol, true))
     {
      // 静默处理，不打印警告（避免日志过多）
     }
   
   // 刷新市场数据以获取实时报价
   RefreshRates();
   
   // 使用 SymbolInfoDouble 获取实时报价（比 MarketInfo 更可靠，自动获取最新报价）
   double bid = SymbolInfoDouble(InpTradeSymbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(InpTradeSymbol, SYMBOL_ASK);
   
   // 如果 SymbolInfoDouble 失败或返回0，回退到 MarketInfo
   if(bid <= 0 || ask <= 0)
     {
      RefreshRates(); // 再次刷新
      bid = MarketInfo(InpTradeSymbol, MODE_BID);
      ask = MarketInfo(InpTradeSymbol, MODE_ASK);
     }
   
   // 调试信息
   static int accountWriteCount = 0;
   accountWriteCount++;
   if(accountWriteCount % 10 == 1)
     {
      Print("WriteMyAccountInfo 调用 #", accountWriteCount, " TradeSymbol=", InpTradeSymbol, " Bid=", bid, " Ask=", ask);
     }
   
   // 即使报价为0（市场休市），也写入账户信息（但使用上次有效报价或0）
   // 这样监控程序至少能看到账户信息
   if(bid <= 0 || ask <= 0)
     {
      if(accountWriteCount % 10 == 1)
        {
         Print("警告：报价无效，但继续写入账户信息（报价将显示为0）");
        }
      // 不返回，继续写入账户信息
      bid = 0;
      ask = 0;
     }

   int accountNumber = AccountNumber();
   double balance = AccountBalance();
   double equity = AccountEquity();
   double margin = AccountMargin();
   double freeMargin = AccountFreeMargin();
   int leverage = AccountLeverage();
   
   // 调试：输出杠杆信息
   if(accountWriteCount % 10 == 1)
     {
      Print("当前账户杠杆：", leverage, " (通过 AccountLeverage() 读取)");
     }

   string fileName = g_stateFilePrefix + "Account_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开账户信息文件失败：", fileName, " 错误代码=", error);
      return(false);
     }

   // 格式化报价（如果为0，显示为0.00000）
   string bidStr = (bid > 0) ? DoubleToString(bid, Digits) : "0.00000";
   string askStr = (ask > 0) ? DoubleToString(ask, Digits) : "0.00000";

   // 写入账户信息，包括手数（第11列）
   FileWrite(handle, 
             TimeToStr(TimeCurrent(), TIME_SECONDS),
             InpBrokerId,
             IntegerToString(accountNumber),
             DoubleToString(balance, 2),
             DoubleToString(equity, 2),
             DoubleToString(margin, 2),
             DoubleToString(freeMargin, 2),
             IntegerToString(leverage),
             bidStr,
             askStr,
             DoubleToString(InpMyLots, 2));  // 添加手数信息
   FileClose(handle);
   
   if(accountWriteCount % 10 == 1)
     {
      Print("账户信息文件写入成功：", fileName);
      Print("  账号=", accountNumber, " 余额=", balance, " 杠杆=", leverage);
      Print("  Bid=", bidStr, " Ask=", askStr);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端持仓信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyPositions()
  {
   string fileName = g_stateFilePrefix + "Positions_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头
   FileWrite(handle, "Ticket;Type;Lots;OpenPrice;CurrentPrice;Profit;Swap;Commission;Time");

   // 遍历所有持仓
   int positionCount = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
     double openPrice = OrderOpenPrice();
     double currentPrice = (type == OP_BUY) ? MarketInfo(InpTradeSymbol, MODE_BID) : MarketInfo(InpTradeSymbol, MODE_ASK);
      double profit = OrderProfit();
      double swap = OrderSwap();
      double commission = OrderCommission();
      datetime openTime = OrderOpenTime();

      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";
      FileWrite(handle, 
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(openPrice, Digits),
                DoubleToString(currentPrice, Digits),
                DoubleToString(profit, 2),
                DoubleToString(swap, 2),
                DoubleToString(commission, 2),
                TimeToString(openTime, TIME_DATE|TIME_MINUTES));
      positionCount++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入交易历史（最近的开仓/平仓记录）                                |
//+------------------------------------------------------------------+
bool WriteTradeHistory()
  {
   string fileName = g_stateFilePrefix + "History_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头：增加开仓价和平仓价字段
   FileWrite(handle, "Time;Action;Ticket;Type;Lots;OpenPrice;ClosePrice;Profit;Comment");

   // 读取最近的交易历史（最多20条）
   int totalOrders = OrdersHistoryTotal();
   int count = 0;
   int maxRecords = 20;

   for(int i = totalOrders - 1; i >= 0 && count < maxRecords; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
      double openPrice = OrderOpenPrice();   // 开仓价
      double closePrice = OrderClosePrice(); // 平仓价
      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      datetime closeTime = OrderCloseTime();
      string comment = OrderComment();

      string action = "CLOSE";
      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";

      FileWrite(handle,
                TimeToString(closeTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                action,
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(openPrice, Digits),   // 开仓价
                DoubleToString(closePrice, Digits),  // 平仓价
                DoubleToString(profit, 2),
                comment);
      count++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端报价                                                 |
//+------------------------------------------------------------------+
bool ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   priceA = 0;
   priceB = 0;

   string fileA = GetPriceFileName("A");
   string fileB = GetPriceFileName("B");

   // A
   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, bidStr, askStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         bidStr = FileReadString(ha);
         askStr = FileReadString(ha);
         if(bidStr != "" && askStr != "")
           {
            double bid = StrToDouble(bidStr);
            double ask = StrToDouble(askStr);
            priceA = (bid + ask) / 2.0;
            haveA = true;
           }
        }
      FileClose(ha);
     }

   // B
   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, bidStr2, askStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         bidStr2 = FileReadString(hb);
         askStr2 = FileReadString(hb);
         if(bidStr2 != "" && askStr2 != "")
           {
            double bid = StrToDouble(bidStr2);
            double ask = StrToDouble(askStr2);
            priceB = (bid + ask) / 2.0;
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 读取两端的 Bid 和 Ask（用于新的开仓/平仓逻辑）                    |
//+------------------------------------------------------------------+
bool ReadBothBidAsk(double &bidA, double &askA, double &bidB, double &askB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   bidA = 0;
   askA = 0;
   bidB = 0;
   askB = 0;

   string fileA = GetPriceFileName("A");
   string fileB = GetPriceFileName("B");

   // A
   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, bidStr, askStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         bidStr = FileReadString(ha);
         askStr = FileReadString(ha);
         if(bidStr != "" && askStr != "")
           {
            bidA = StrToDouble(bidStr);
            askA = StrToDouble(askStr);
            haveA = true;
           }
        }
      FileClose(ha);
     }

   // B
   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, bidStr2, askStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         bidStr2 = FileReadString(hb);
         askStr2 = FileReadString(hb);
         if(bidStr2 != "" && askStr2 != "")
           {
            bidB = StrToDouble(bidStr2);
            askB = StrToDouble(askStr2);
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 读取指定Broker的账户信息文件中的手数                              |
//+------------------------------------------------------------------+
bool ReadAccountLots(const string brokerId, double &lots)
  {
   lots = 0;
   string fileName = g_stateFilePrefix + "Account_" + InpSymbol + "_" + brokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      Print("【ReadAccountLots】无法打开账户信息文件：", fileName);
      return(false);
     }
   
   // 读取第一行
   string line = FileReadString(handle);
   FileClose(handle);
   
   if(StringLen(line) <= 0)
     {
      Print("【ReadAccountLots】账户信息文件为空：", fileName);
      return(false);
     }
   
   // 解析CSV行（用分号分隔）
   string parts[];
   int partCount = StringSplit(line, ';', parts);
   
   // 账户信息格式：时间;BrokerId;账号;余额;净值;已用保证金;可用保证金;杠杆;Bid;Ask;手数
   // 手数在第11列（索引10）
   if(partCount >= 11)
     {
      lots = StrToDouble(parts[10]);
      if(lots > 0)
        {
         Print("【ReadAccountLots】成功读取 ", brokerId, " 的手数：", lots);
         return(true);
        }
     }
   
   Print("【ReadAccountLots】无法从账户信息文件中读取手数：", fileName, " 列数=", partCount);
   return(false);
  }

//+------------------------------------------------------------------+
//| 当前 EA 是否代表 Broker A                                        |
//+------------------------------------------------------------------+
bool IsMyBrokerA()
  {
   return(StringCompare(InpBrokerId, "A", false) == 0);
  }

//+------------------------------------------------------------------+
//| 检查是否已有对冲仓                                               |
//+------------------------------------------------------------------+
bool HaveOpenHedgePositions()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;
      // 只要本 EA 在该品种下有持仓，就认为有一组对冲在运行
      return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
//| 主控端：检查是否需要开一组对冲仓                                 |
//+------------------------------------------------------------------+
void CheckAndOpenHedge()
  {
   // 如果已有对冲仓，则不再开新的（简单版本：每次只维护一组仓位）
   if(HaveOpenHedgePositions())
      return;

   // 检查是否有未完成的平仓指令（如果有，等待平仓完成后再开新仓）
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      string cmdLine = FileReadString(handle);
      FileClose(handle);
      if(StringLen(cmdLine) > 0)
        {
         string parts[4];
         int partCount = StringSplit(cmdLine, ';', parts);
         if(partCount > 0 && StringCompare(parts[0], "CLOSEALL", false) == 0)
           {
            // 有平仓指令未完成，等待平仓完成
            return;
           }
        }
     }

   // ==== 新的开仓逻辑：使用价差绝对值 ====
   double bidA, askA, bidB, askB;
   bool haveA, haveB;
   if(!ReadBothBidAsk(bidA, askA, bidB, askB, haveA, haveB))
     {
      Print("【开仓检查】无法读取两端报价：haveA=", haveA, " haveB=", haveB);
      return;
     }

   double pipSize = GetPointPip();
   if(pipSize <= 0)
     {
      Print("【开仓检查】pipSize 无效：", pipSize);
      return;
     }

   // 计算两个价差：
   // Diff1 = Bid_B - Ask_A（B的买价 - A的卖价）
   // Diff2 = Bid_A - Ask_B（A的买价 - B的卖价）
   double diff1 = bidB - askA;
   double diff2 = bidA - askB;
   double diff1Pips = diff1 / pipSize;
   double diff2Pips = diff2 / pipSize;
   
   // 计算绝对值
   double absDiff1Pips = MathAbs(diff1Pips);
   double absDiff2Pips = MathAbs(diff2Pips);
   
   // 选择较大的价差绝对值
   double maxAbsDiffPips = MathMax(absDiff1Pips, absDiff2Pips);
   double selectedDiff = (absDiff1Pips >= absDiff2Pips) ? diff1 : diff2;
   double selectedDiffPips = (absDiff1Pips >= absDiff2Pips) ? diff1Pips : diff2Pips;
   
   // 调试日志：打印当前价差
   Print("【开仓检查】价差1(Bid_B-Ask_A)=", DoubleToString(diff1Pips, 2), " 点，价差2(Bid_A-Ask_B)=", DoubleToString(diff2Pips, 2), 
         " 点，最大绝对值=", DoubleToString(maxAbsDiffPips, 2), " 点，阈值=", IntegerToString(InpThresholdPips), 
         " 点，上次价差=", DoubleToString(g_lastDiff, 2), " 点");

   // 开仓条件：|Diff| > P_open 且持续扩大
   if(maxAbsDiffPips <= InpThresholdPips)
     {
      // 价差未达到阈值，更新记录但不开仓
      if(g_lastDiff > 0)
        {
         g_lastDiff = maxAbsDiffPips; // 更新记录
        }
      return;
     }

   // 价差达到阈值，检查是否持续扩大
   // 如果 g_lastDiff = 0（首次达到阈值），直接开仓
   // 如果 g_lastDiff > 0，需要价差持续扩大才开仓
   if(g_lastDiff > 0 && maxAbsDiffPips <= g_lastDiff)
     {
      // 价差达到阈值但没有持续扩大，更新记录但不开仓
      Print("【开仓检查】价差已达到阈值 ", DoubleToString(maxAbsDiffPips, 2), " 点，但未持续扩大（上次=", DoubleToString(g_lastDiff, 2), " 点），等待价差扩大");
      g_lastDiff = maxAbsDiffPips; // 更新记录
      return;
     }

   // 价差达到阈值且持续扩大（或首次达到阈值），记录当前价差
   Print("【开仓检查】价差已达到阈值且持续扩大：", DoubleToString(maxAbsDiffPips, 2), " 点（上次=", DoubleToString(g_lastDiff, 2), " 点），准备开仓");
   g_lastDiff = maxAbsDiffPips;

   // 检查是否有未完成的开仓指令（如果有，等待完成后再发送新指令）
   // 重用上面已定义的 fileName 变量
   int handleCheck = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handleCheck != INVALID_HANDLE)
     {
      string existingCmd = FileReadString(handleCheck);
      FileClose(handleCheck);
      if(StringLen(existingCmd) > 0)
        {
         string parts[4];
         int partCount = StringSplit(existingCmd, ';', parts);
         if(partCount > 0 && StringCompare(parts[0], "OPEN", false) == 0)
           {
            // 有未完成的开仓指令，检查是否已经失败或成功
            string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
            string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
            bool failedA = false, failedB = false;
            bool ackedA = false, ackedB = false;
            
            int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
            if(ha != INVALID_HANDLE)
              {
               string ackLine = FileReadString(ha);
               FileClose(ha);
               if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, existingCmd) > 0)
                  failedA = true;
               else if(StringCompare(ackLine, existingCmd, false) == 0)
                  ackedA = true;
              }
            
            int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
            if(hb != INVALID_HANDLE)
              {
               string ackLine = FileReadString(hb);
               FileClose(hb);
               if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, existingCmd) > 0)
                  failedB = true;
               else if(StringCompare(ackLine, existingCmd, false) == 0)
                  ackedB = true;
              }
            
            // 如果两边都成功，说明指令已经完成，但指令文件没有被清除，清除它
            if(ackedA && ackedB)
              {
               Print("【开仓检查】检测到之前的开仓指令两边都已成功，但指令文件未被清除，清除指令文件");
               ClearCommandFile();
               // 清除确认文件
               if(FileIsExist(fileA, FILE_COMMON))
                  FileDelete(fileA, FILE_COMMON);
               if(FileIsExist(fileB, FILE_COMMON))
                  FileDelete(fileB, FILE_COMMON);
               // 重置变量
               if(InpIsMaster)
                 {
                  g_lastCommandSendTime = 0;
                  g_lastCommandSent = "";
                 }
               // 重置已执行指令记录（所有终端都需要重置）
               g_lastExecutedCommand = "";
              }
            // 如果两边都失败，清除指令文件，允许发送新指令（但需要等待一段时间）
            else if(failedA && failedB)
              {
               // 检查是否已经过了足够的时间（5秒）再允许发送新指令
               datetime currentTime = TimeCurrent();
               int secondsSinceLastFailure = (int)(currentTime - g_lastFailedOpenTime);
               
               if(secondsSinceLastFailure < 5)
                 {
                  Print("【开仓检查】检测到之前的开仓指令两边都失败，但距离上次失败仅 ", secondsSinceLastFailure, " 秒，等待 ", (5 - secondsSinceLastFailure), " 秒后再重试");
                  return; // 等待足够的时间再重试
                 }
               
               Print("【开仓检查】检测到之前的开仓指令两边都失败，且已等待 ", secondsSinceLastFailure, " 秒，清除指令文件，允许发送新指令");
               ClearCommandFile();
               // 清除确认文件
               if(FileIsExist(fileA, FILE_COMMON))
                  FileDelete(fileA, FILE_COMMON);
               if(FileIsExist(fileB, FILE_COMMON))
                  FileDelete(fileB, FILE_COMMON);
               // 重置失败时间和指令发送时间
               g_lastFailedOpenTime = 0;
               if(InpIsMaster)
                 {
                  g_lastCommandSendTime = 0;
                  g_lastCommandSent = "";
                 }
               // 重置已执行指令记录（所有终端都需要重置）
               g_lastExecutedCommand = "";
              }
            else
              {
               // 有未完成的指令且未完全失败，等待完成
               return;
              }
           }
        }
     }

   // ==== 新的开仓逻辑：根据中间价比较决定开仓方向 ====
   // 规则：如果 A > B（A的报价更高），则 A 开空，B 开多
   //      如果 A < B（A的报价更低），则 A 开多，B 开空
   string longBroker, shortBroker;
   
   // 计算 A 和 B 的中间价
   double midPriceA = (bidA + askA) / 2.0;
   double midPriceB = (bidB + askB) / 2.0;
   
   // 根据中间价比较决定开仓方向
   if(midPriceA > midPriceB)
     {
      // A 的报价更高，A 开空，B 开多
      longBroker = "B";  // B 开多
      shortBroker = "A"; // A 开空
      Print("【开仓方向】A中间价(", DoubleToString(midPriceA, 5), ") > B中间价(", DoubleToString(midPriceB, 5), ")，A开空，B开多");
     }
   else
     {
      // A 的报价更低，A 开多，B 开空
      longBroker = "A";  // A 开多
      shortBroker = "B"; // B 开空
      Print("【开仓方向】A中间价(", DoubleToString(midPriceA, 5), ") < B中间价(", DoubleToString(midPriceB, 5), ")，A开多，B开空");
     }

   // 记录开仓时的价差（用于止损计算，使用绝对值）
   g_openDiff = maxAbsDiffPips;

   // 通过状态文件发送开仓指令：格式示例
   // OPEN;longBroker;shortBroker
   // 注意：指令中不包含手数，每个终端执行时使用自己的InpMyLots
   Print("【发送开仓指令】longBroker=", longBroker, " shortBroker=", shortBroker);
   Print("【发送开仓指令】每个终端将使用自己的手数（A端InpMyLots=", (StringCompare(InpBrokerId, "A", false) == 0 ? DoubleToString(InpMyLots, 2) : "未知"), 
         " B端InpMyLots=", (StringCompare(InpBrokerId, "B", false) == 0 ? DoubleToString(InpMyLots, 2) : "未知"), ")");
   string cmd = "OPEN;" + longBroker + ";" + shortBroker;
   SendCommand(cmd);
   Print("【新开仓逻辑】发送开仓指令：", cmd, " 最大价差绝对值=", DoubleToString(maxAbsDiffPips, 1), 
         " 点（价差1=", DoubleToString(diff1Pips, 1), " 点，价差2=", DoubleToString(diff2Pips, 1), 
         " 点），开仓价差已记录=", DoubleToString(g_openDiff, 1), " 点");
  }

//+------------------------------------------------------------------+
//| 计算本终端所有对冲仓的盈亏（以点为单位，按绝对值累加）           |
//+------------------------------------------------------------------+
double CalcMyProfitPips()
  {
   double totalPips = 0.0;
   double pipSize = GetPointPip();
   if(pipSize <= 0)
      return(0.0);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      // 换算点数 = 盈利金额 / (手数 * 每tick货币价值) * (tickSize / pipSize)
      // 其中：tickValue是每tick的价值（对于1标准手），tickSize是每tick的价格增量，pipSize是每点的价格增量
     double tickValue = MarketInfo(InpTradeSymbol, MODE_TICKVALUE);
     double tickSize = MarketInfo(InpTradeSymbol, MODE_TICKSIZE);
      if(tickValue <= 0 || OrderLots() <= 0 || tickSize <= 0)
         continue;
      // 计算盈亏的tick数
      double profitTicks = profit / (OrderLots() * tickValue);
      // 将tick数转换为点数
      double pips = profitTicks * (tickSize / pipSize);
      totalPips += pips;
     }
   return(totalPips);
  }

//+------------------------------------------------------------------+
//| 写入本终端当前合计盈亏（点数）                                   |
//+------------------------------------------------------------------+
bool WriteMyProfit(double profitPips)
  {
   string fileName = g_stateFilePrefix + InpSymbol + "_" + InpBrokerId + "_profit.csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      Print("打开盈亏文件失败：", fileName, " 错误代码=", GetLastError());
      return(false);
     }
   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(profitPips, 2));
   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端盈亏（点）                                          |
//+------------------------------------------------------------------+
bool ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   pipsA = 0;
   pipsB = 0;

   string fileA = g_stateFilePrefix + InpSymbol + "_A_profit.csv";
   string fileB = g_stateFilePrefix + InpSymbol + "_B_profit.csv";

   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, pipsStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         pipsStr = FileReadString(ha);
         if(pipsStr != "")
           {
            pipsA = StrToDouble(pipsStr);
            haveA = true;
           }
        }
      FileClose(ha);
     }

   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, pipsStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         pipsStr2 = FileReadString(hb);
         if(pipsStr2 != "")
           {
            pipsB = StrToDouble(pipsStr2);
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 计算本终端所有对冲仓的盈亏（以美元为单位）                       |
//+------------------------------------------------------------------+
double CalcMyProfitUSD()
  {
   double totalProfit = 0.0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      // 盈亏金额 = 订单盈亏 + 库存费 + 手续费
      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      totalProfit += profit;
     }
   return(totalProfit);
  }

//+------------------------------------------------------------------+
//| 写入本终端当前合计盈亏（美元）                                   |
//+------------------------------------------------------------------+
