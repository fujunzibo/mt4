//+------------------------------------------------------------------+
//|                                                 HedgeArbEA.mq4  |
//|                 双平台报价价差对冲套利 EA（MT4，本地文件通信）     |
//+------------------------------------------------------------------+
#property strict
#property copyright "Generated by AI"
#property link      ""
#property version   "1.00"
#property description "双经纪商 MT4 对冲套利：一边多、一边空，通过公共文件夹通信。"

//--- 输入参数
input string   InpSymbol          = "EURUSD";   // 交易品种（需与图表品种一致或可交易）
input double   InpLots            = 1.0;        // 每边手数
input int      InpThresholdPips   = 5;          // 开仓触发点差（两平台报价差，单位：点）
input int      InpCloseTotalPips  = 10;         // 平仓条件：两边合计盈利 >= 多少点
input string   InpBrokerId        = "A";        // 本终端标识（例如：A / B）
input bool     InpIsMaster        = true;       // 是否为主控端（必须有一个为 true，一个为 false）
input int      InpMagic           = 20251126;   // EA Magic Number
input int      InpSlippage        = 3;          // 最大允许滑点（点）
input int      InpCheckIntervalMs = 500;        // 检查周期（毫秒）
input bool     InpUseTimer        = false;      // 使用定时器模式（周末测试用，市场开盘时设为 false）

//--- 常量 & 文件名基准
string g_priceFilePrefix   = "ArbPrice_";   // 报价文件前缀
string g_stateFilePrefix   = "ArbState_";   // 状态/指令文件前缀

//--- 运行时变量
datetime g_lastCheckTime = 0;
int      g_lastTickTimeMs = 0;
int      g_timerId = -1;
string   g_lastExecutedCommand = "";  // 记录最后执行的指令，避免重复执行

//--- 工具函数声明
double   GetPointPip();
string   GetPriceFileName(const string brokerId);
string   GetStateFileName();
bool     WriteMyPrice();
bool     WriteMyAccountInfo();
bool     WriteMyPositions();
bool     WriteTradeHistory();
bool     ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB);
bool     IsMyBrokerA();
bool     HaveOpenHedgePositions();
void     CheckAndOpenHedge();
void     CheckAndCloseHedge();
double   CalcMyProfitPips();
bool     WriteMyProfit(double profitPips);
bool     ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB);
void     ExecCommands();
void     SendCommand(const string cmd);
void     WriteCommandAck(const string cmdLine);
bool     CheckBothAcked(const string cmdLine);
void     CleanupCompletedCommands();
void     ClearCommandFile();

//+------------------------------------------------------------------+
//| EA 初始化                                                         |
//+------------------------------------------------------------------+
int OnInit()
  {
   if(StringLen(InpBrokerId) <= 0)
     {
      Print("错误：请在参数中设置 InpBrokerId（例如 A 或 B）");
      return(INIT_FAILED);
     }

   if(InpLots <= 0)
     {
      Print("错误：手数 InpLots 必须大于 0");
      return(INIT_FAILED);
     }

   if(Symbol() != InpSymbol)
      Print("警告：当前图表品种(", Symbol(), ") 与参数 InpSymbol(", InpSymbol, ") 不一致，将按 InpSymbol 交易。");

   Print("HedgeArbEA 初始化完成。BrokerId=", InpBrokerId,
         " IsMaster=", (InpIsMaster ? "true" : "false"),
         " Symbol=", InpSymbol,
         " UseTimer=", (InpUseTimer ? "true" : "false"));

   // 如果启用定时器模式，创建定时器（用于周末测试）
   if(InpUseTimer)
     {
      // 计算定时器间隔（秒），确保至少1秒
      int timerSeconds = (int)MathMax(1, InpCheckIntervalMs / 1000.0);
      if(timerSeconds < 1) timerSeconds = 1; // 双重保险，至少1秒
      
      Print("准备创建定时器：InpCheckIntervalMs=", InpCheckIntervalMs, "ms, 转换为秒=", timerSeconds);
      
      g_timerId = EventSetTimer(timerSeconds);
      if(g_timerId == -1)
        {
         int error = GetLastError();
         Print("【错误】定时器创建失败，错误代码=", error, " 尝试的间隔=", timerSeconds, "秒");
        }
      else
        {
         Print("【成功】定时器模式已启用，每 ", timerSeconds, " 秒执行一次，TimerId=", g_timerId);
         // 立即执行一次，测试是否能写入文件
         Print("立即执行一次测试写入...");
         ExecuteMainLogic();
        }
     }
   else
     {
      Print("【提示】未启用定时器模式，EA 将在市场有 Tick 时执行（周末市场休市时不会执行）");
      Print("【提示】如需周末测试，请将 InpUseTimer 设置为 true");
     }

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| EA 去初始化                                                       |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   // 删除定时器
   if(g_timerId != -1)
     {
      EventKillTimer();
      g_timerId = -1;
     }
   Print("HedgeArbEA 结束，BrokerId=", InpBrokerId);
  }

//+------------------------------------------------------------------+
//| 每个 Tick 调用                                                   |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 如果使用定时器模式，OnTick 不执行（由 OnTimer 执行）
   if(InpUseTimer)
      return;

   // 控制检查频率，避免 CPU 占用过高
   uint millis = GetTickCount();
   if((int)(millis - g_lastTickTimeMs) < InpCheckIntervalMs)
      return;
   g_lastTickTimeMs = (int)millis;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 定时器事件（用于周末测试）                                        |
//+------------------------------------------------------------------+
void OnTimer()
  {
   if(!InpUseTimer)
      return;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 主要逻辑（从 OnTick 和 OnTimer 调用）                            |
//+------------------------------------------------------------------+
void ExecuteMainLogic()
  {
   static int execCount = 0;
   execCount++;
   
   // 每10次输出一次调试信息
   if(execCount % 10 == 1)
     {
      Print("ExecuteMainLogic 执行 #", execCount, " BrokerId=", InpBrokerId, " UseTimer=", (InpUseTimer ? "true" : "false"));
     }
   
   // 写入自己的报价
   WriteMyPrice();
   
   // 写入账户信息
   WriteMyAccountInfo();
   
   // 写入持仓信息
   WriteMyPositions();
   
   // 写入交易历史（每10次执行一次，避免过于频繁）
   static int historyWriteCount = 0;
   historyWriteCount++;
   if(historyWriteCount % 10 == 0)
     {
      WriteTradeHistory();
     }

   // 响应来自主控端的指令（开仓/平仓）
   ExecCommands();

   // 主控端负责：判断是否开仓 & 是否平仓 & 清理已完成的指令
   if(InpIsMaster)
     {
      // 检查并清理已完成的指令
      CleanupCompletedCommands();
      
      CheckAndOpenHedge();
      CheckAndCloseHedge();
     }
  }

//+------------------------------------------------------------------+
//| 获得“1 点”对应的价格增量（有的品种 Point 是 0.00001，则 1 点=10*Point）|
//+------------------------------------------------------------------+
double GetPointPip()
  {
   // 通常 3/5 位小数的货币对：1 点 = 10 * Point
   if(Digits == 3 || Digits == 5)
      return(Point * 10);
   // 其他情况直接按 1 Point 作为 1 点
   return(Point);
  }

//+------------------------------------------------------------------+
//| 根据 BrokerId 生成报价文件名（公共文件夹）                       |
//+------------------------------------------------------------------+
string GetPriceFileName(const string brokerId)
  {
   string name = g_priceFilePrefix + InpSymbol + "_" + brokerId + ".csv";
   return(name);
  }

//+------------------------------------------------------------------+
//| 状态/指令文件名                                                  |
//+------------------------------------------------------------------+
string GetStateFileName()
  {
   string name = g_stateFilePrefix + InpSymbol + ".txt";
   return(name);
  }

//+------------------------------------------------------------------+
//| 写入本终端报价到公共文件夹                                      |
//+------------------------------------------------------------------+
bool WriteMyPrice()
  {
   double bid = MarketInfo(InpSymbol, MODE_BID);
   double ask = MarketInfo(InpSymbol, MODE_ASK);
   
   // 调试信息
   static int writeCount = 0;
   writeCount++;
   if(writeCount % 10 == 1) // 每10次输出一次，避免日志过多
     {
      Print("WriteMyPrice 调用 #", writeCount, " Symbol=", InpSymbol, " Bid=", bid, " Ask=", ask);
     }
   
   if(bid <= 0 || ask <= 0)
     {
      Print("警告：报价无效 Bid=", bid, " Ask=", ask);
      return(false);
     }

   string fileName = GetPriceFileName(InpBrokerId);
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开报价文件失败：", fileName, " 错误代码=", error);
      Print("公共文件夹路径检查：FILE_COMMON 标志已使用");
      Print("【诊断】错误 5004 通常表示：");
      Print("  1. Common\\Files 文件夹不存在或无法访问");
      Print("  2. MT4 数据文件夹路径问题");
      Print("  3. 文件权限问题");
      Print("  解决方案：");
      Print("  → 在 MT4 中：文件 → 打开数据文件夹");
      Print("  → 返回上一级，确认 Common\\Files 文件夹存在");
      Print("  → 如果不存在，手动创建 Common\\Files 文件夹");
      return(false);
     }

   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(bid, Digits), DoubleToString(ask, Digits));
   FileClose(handle);
   
   if(writeCount % 10 == 1)
     {
      Print("报价文件写入成功：", fileName);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端账户信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyAccountInfo()
  {
   double bid = MarketInfo(InpSymbol, MODE_BID);
   double ask = MarketInfo(InpSymbol, MODE_ASK);
   
   // 调试信息
   static int accountWriteCount = 0;
   accountWriteCount++;
   if(accountWriteCount % 10 == 1)
     {
      Print("WriteMyAccountInfo 调用 #", accountWriteCount, " Bid=", bid, " Ask=", ask);
     }
   
   // 即使报价为0（市场休市），也写入账户信息（但使用上次有效报价或0）
   // 这样监控程序至少能看到账户信息
   if(bid <= 0 || ask <= 0)
     {
      if(accountWriteCount % 10 == 1)
        {
         Print("警告：报价无效，但继续写入账户信息（报价将显示为0）");
        }
      // 不返回，继续写入账户信息
      bid = 0;
      ask = 0;
     }

   int accountNumber = AccountNumber();
   double balance = AccountBalance();
   double equity = AccountEquity();
   double margin = AccountMargin();
   double freeMargin = AccountFreeMargin();
   int leverage = AccountLeverage();
   
   // 调试：输出杠杆信息
   if(accountWriteCount % 10 == 1)
     {
      Print("当前账户杠杆：", leverage, " (通过 AccountLeverage() 读取)");
     }

   string fileName = g_stateFilePrefix + "Account_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开账户信息文件失败：", fileName, " 错误代码=", error);
      if(error == 5004)
        {
         Print("【诊断】错误 5004：无法访问 Common\\Files 文件夹");
         Print("  解决方案：检查 MT4 数据文件夹路径和 Common\\Files 文件夹权限");
        }
      return(false);
     }

   // 格式化报价（如果为0，显示为0.00000）
   string bidStr = (bid > 0) ? DoubleToString(bid, Digits) : "0.00000";
   string askStr = (ask > 0) ? DoubleToString(ask, Digits) : "0.00000";

   FileWrite(handle, 
             TimeToStr(TimeCurrent(), TIME_SECONDS),
             InpBrokerId,
             IntegerToString(accountNumber),
             DoubleToString(balance, 2),
             DoubleToString(equity, 2),
             DoubleToString(margin, 2),
             DoubleToString(freeMargin, 2),
             IntegerToString(leverage),
             bidStr,
             askStr);
   FileClose(handle);
   
   if(accountWriteCount % 10 == 1)
     {
      Print("账户信息文件写入成功：", fileName);
      Print("  账号=", accountNumber, " 余额=", balance, " 杠杆=", leverage);
      Print("  Bid=", bidStr, " Ask=", askStr);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端持仓信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyPositions()
  {
   string fileName = g_stateFilePrefix + "Positions_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头
   FileWrite(handle, "Ticket;Type;Lots;OpenPrice;CurrentPrice;Profit;Swap;Commission;Time");

   // 遍历所有持仓
   int positionCount = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != InpSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
      double openPrice = OrderOpenPrice();
      double currentPrice = (type == OP_BUY) ? MarketInfo(InpSymbol, MODE_BID) : MarketInfo(InpSymbol, MODE_ASK);
      double profit = OrderProfit();
      double swap = OrderSwap();
      double commission = OrderCommission();
      datetime openTime = OrderOpenTime();

      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";
      FileWrite(handle, 
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(openPrice, Digits),
                DoubleToString(currentPrice, Digits),
                DoubleToString(profit, 2),
                DoubleToString(swap, 2),
                DoubleToString(commission, 2),
                TimeToString(openTime, TIME_DATE|TIME_MINUTES));
      positionCount++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入交易历史（最近的开仓/平仓记录）                                |
//+------------------------------------------------------------------+
bool WriteTradeHistory()
  {
   string fileName = g_stateFilePrefix + "History_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头
   FileWrite(handle, "Time;Action;Ticket;Type;Lots;Price;Profit;Comment");

   // 读取最近的交易历史（最多20条）
   int totalOrders = OrdersHistoryTotal();
   int count = 0;
   int maxRecords = 20;

   for(int i = totalOrders - 1; i >= 0 && count < maxRecords; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
      if(OrderSymbol() != InpSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
      double price = OrderClosePrice();
      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      datetime closeTime = OrderCloseTime();
      string comment = OrderComment();

      string action = "CLOSE";
      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";

      FileWrite(handle,
                TimeToString(closeTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                action,
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(price, Digits),
                DoubleToString(profit, 2),
                comment);
      count++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端报价                                                 |
//+------------------------------------------------------------------+
bool ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   priceA = 0;
   priceB = 0;

   string fileA = GetPriceFileName("A");
   string fileB = GetPriceFileName("B");

   // A
   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, bidStr, askStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         bidStr = FileReadString(ha);
         askStr = FileReadString(ha);
         if(bidStr != "" && askStr != "")
           {
            double bid = StrToDouble(bidStr);
            double ask = StrToDouble(askStr);
            priceA = (bid + ask) / 2.0;
            haveA = true;
           }
        }
      FileClose(ha);
     }

   // B
   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, bidStr2, askStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         bidStr2 = FileReadString(hb);
         askStr2 = FileReadString(hb);
         if(bidStr2 != "" && askStr2 != "")
           {
            double bid = StrToDouble(bidStr2);
            double ask = StrToDouble(askStr2);
            priceB = (bid + ask) / 2.0;
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 当前 EA 是否代表 Broker A                                        |
//+------------------------------------------------------------------+
bool IsMyBrokerA()
  {
   return(StringCompare(InpBrokerId, "A", false) == 0);
  }

//+------------------------------------------------------------------+
//| 检查是否已有对冲仓                                               |
//+------------------------------------------------------------------+
bool HaveOpenHedgePositions()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != InpSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;
      // 只要本 EA 在该品种下有持仓，就认为有一组对冲在运行
      return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
//| 主控端：检查是否需要开一组对冲仓                                 |
//+------------------------------------------------------------------+
void CheckAndOpenHedge()
  {
   // 如果已有对冲仓，则不再开新的（简单版本：每次只维护一组仓位）
   if(HaveOpenHedgePositions())
      return;

   double priceA, priceB;
   bool haveA, haveB;
   if(!ReadBothPrices(priceA, priceB, haveA, haveB))
      return;

   double pipSize = GetPointPip();
   if(pipSize <= 0)
      return;

   double diff = priceA - priceB; // A - B
   double diffPips = diff / pipSize;

   // 绝对价差达到阈值才考虑开仓
   if(MathAbs(diffPips) < InpThresholdPips)
      return;

   // 决定哪边做多哪边做空：
   // 如果 A 报价更高（A > B），则：在 A 做空，在 B 做多
   // 如果 A 报价更低（A < B），则：在 A 做多，在 B 做空
   string longBroker, shortBroker;
   if(diff > 0)
     {
      longBroker  = "B";
      shortBroker = "A";
     }
   else
     {
      longBroker  = "A";
      shortBroker = "B";
     }

   // 通过状态文件发送开仓指令：格式示例
   // OPEN;longBroker;shortBroker;lots
   string cmd = "OPEN;" + longBroker + ";" + shortBroker + ";" + DoubleToString(InpLots, 2);
   SendCommand(cmd);
   Print("发送开仓指令：", cmd, " 价差=", DoubleToString(diffPips, 1), " 点");
  }

//+------------------------------------------------------------------+
//| 计算本终端所有对冲仓的盈亏（以点为单位，按绝对值累加）           |
//+------------------------------------------------------------------+
double CalcMyProfitPips()
  {
   double totalPips = 0.0;
   double pipSize = GetPointPip();
   if(pipSize <= 0)
      return(0.0);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != InpSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      // 换算点数 = 盈利金额 / (手数 * 每点货币价值 / pipSize)
      double tickValue = MarketInfo(InpSymbol, MODE_TICKVALUE);
      if(tickValue <= 0 || OrderLots() <= 0)
         continue;
      double pips = profit / (OrderLots() * tickValue) / pipSize;
      totalPips += pips;
     }
   return(totalPips);
  }

//+------------------------------------------------------------------+
//| 写入本终端当前合计盈亏（点数）                                   |
//+------------------------------------------------------------------+
bool WriteMyProfit(double profitPips)
  {
   string fileName = g_stateFilePrefix + InpSymbol + "_" + InpBrokerId + "_profit.csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      Print("打开盈亏文件失败：", fileName, " 错误代码=", GetLastError());
      return(false);
     }
   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(profitPips, 2));
   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端盈亏（点）                                          |
//+------------------------------------------------------------------+
bool ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   pipsA = 0;
   pipsB = 0;

   string fileA = g_stateFilePrefix + InpSymbol + "_A_profit.csv";
   string fileB = g_stateFilePrefix + InpSymbol + "_B_profit.csv";

   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, pipsStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         pipsStr = FileReadString(ha);
         if(pipsStr != "")
           {
            pipsA = StrToDouble(pipsStr);
            haveA = true;
           }
        }
      FileClose(ha);
     }

   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, pipsStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         pipsStr2 = FileReadString(hb);
         if(pipsStr2 != "")
           {
            pipsB = StrToDouble(pipsStr2);
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 主控端：检查是否满足总盈利点数平仓（自动平仓）                   |
//+------------------------------------------------------------------+
void CheckAndCloseHedge()
  {
   if(!HaveOpenHedgePositions())
      return;

   // 各端先写各自当前盈利
   double myPips = CalcMyProfitPips();
   WriteMyProfit(myPips);

   double pipsA, pipsB;
   bool haveA, haveB;
   if(!ReadBothProfits(pipsA, pipsB, haveA, haveB))
      return;

   // 计算两边合计盈利点数（A+B）
   double totalPips = pipsA + pipsB;

   // 当合计盈利达到目标点数时，自动平仓
   if(totalPips >= InpCloseTotalPips)
     {
      string cmd = "CLOSEALL;";
      SendCommand(cmd);
      Print("【自动平仓】合计盈利 ", DoubleToString(totalPips, 2), " 点 >= 目标 ", 
            IntegerToString(InpCloseTotalPips), " 点，已发送平仓指令");
     }
  }

//+------------------------------------------------------------------+
//| 清理已完成的指令（主控端调用）                                    |
//+------------------------------------------------------------------+
void CleanupCompletedCommands()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
      return;
   
   string cmdLine = FileReadString(handle);
   FileClose(handle);
   
   if(StringLen(cmdLine) <= 0)
      return;
   
   // 检查是否是 OPEN 指令
   string parts[4];
   int partCount = StringSplit(cmdLine, ';', parts);
   if(partCount > 0 && StringCompare(parts[0], "OPEN", false) == 0)
     {
      // 检查两个终端是否都已确认执行
      if(CheckBothAcked(cmdLine))
        {
         // 两个终端都已执行，清除指令文件
         ClearCommandFile();
         Print("【指令清理】两个终端都已执行指令，已清除指令文件");
        }
     }
  }

//+------------------------------------------------------------------+
//| 向状态文件写入指令（覆盖写入，最后一条为最新）                   |
//+------------------------------------------------------------------+
void SendCommand(const string cmd)
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle == INVALID_HANDLE)
     {
      Print("打开状态文件失败：", fileName, " 错误代码=", GetLastError());
      return;
     }
   FileWriteString(handle, cmd);
   FileClose(handle);
  }

//+------------------------------------------------------------------+
//| 读取并执行针对本终端的指令                                       |
//+------------------------------------------------------------------+
void ExecCommands()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
      return; // 文件可能暂时不存在，忽略

   string cmdLine = FileReadString(handle);
   FileClose(handle);

   if(StringLen(cmdLine) <= 0)
      return;

   // 简单解析：用分号分隔
   string parts[4];
   int partCount = StringSplit(cmdLine, ';', parts);
   if(partCount <= 0)
      return;

   string action = parts[0];

   if(action == "OPEN" && partCount >= 4)
     {
      // 检查是否已经执行过这个指令（避免重复执行）
      if(StringCompare(cmdLine, g_lastExecutedCommand, false) == 0)
         return; // 已经执行过，跳过
      
      // 检查是否已经有持仓（避免重复开仓）
      if(HaveOpenHedgePositions())
        {
         Print("【跳过开仓】已有持仓，等待平仓后再开新仓");
         g_lastExecutedCommand = cmdLine; // 标记为已处理，避免重复检查
         return;
        }
      
      string longBroker  = parts[1];
      string shortBroker = parts[2];
      double lots        = StrToDouble(parts[3]);

      if(lots <= 0)
         return;

      // 判断本端该做多还是做空
      if(StringCompare(InpBrokerId, longBroker, false) == 0)
        {
         // BUY
         double askPrice = MarketInfo(InpSymbol, MODE_ASK);
         double point = MarketInfo(InpSymbol, MODE_POINT);
         double minLot = MarketInfo(InpSymbol, MODE_MINLOT);
         double maxLot = MarketInfo(InpSymbol, MODE_MAXLOT);
         double lotStep = MarketInfo(InpSymbol, MODE_LOTSTEP);
         
         // 检查手数是否有效
         if(lots < minLot)
           {
            Print("【开多失败】手数太小：", lots, " < 最小手数：", minLot);
            return;
           }
         if(lots > maxLot)
           {
            Print("【开多失败】手数太大：", lots, " > 最大手数：", maxLot);
            return;
           }
         
         // 规范化手数
         lots = MathFloor(lots / lotStep) * lotStep;
         
         Print("准备开多：Symbol=", InpSymbol, " Lots=", lots, " Ask=", askPrice, " Slippage=", InpSlippage);
         
         // 交易前检查
         if(!IsTradeAllowed())
           {
            Print("【开多失败】交易被禁止 - 请检查：");
            Print("  1. MT4 工具栏的'自动交易'按钮是否已启用？");
            Print("  2. EA 属性中'允许自动交易'是否已勾选？");
            Print("  3. 账户是否被锁定或禁止交易？");
            Print("  4. 是否在允许的交易时间内？");
            return;
           }
         
         if(IsTradeContextBusy())
           {
            Print("【开多失败】交易上下文繁忙，请稍后重试");
            return;
           }
         
         int ticket = OrderSend(InpSymbol, OP_BUY, lots, askPrice, InpSlippage, 0, 0,
                                "HedgeArb BUY", InpMagic, 0, clrBlue);
         if(ticket < 0)
           {
            int error = GetLastError();
            string errorDesc = GetErrorDescription(error);
            Print("【开多失败】错误代码=", error, " (", errorDesc, ")");
            Print("   Symbol=", InpSymbol, " Lots=", lots, " Ask=", askPrice, " Slippage=", InpSlippage);
            Print("   账户余额=", AccountBalance(), " 可用保证金=", AccountFreeMargin());
            
            // 如果是错误 133，提供详细的解决建议
            if(error == 133)
              {
               Print("【错误 133 解决方案】");
               Print("  → 步骤 1：检查 MT4 工具栏的'自动交易'按钮（绿色播放图标）是否已启用");
               Print("  → 步骤 2：右键点击 EA → 属性 → 确保'允许自动交易'已勾选");
               Print("  → 步骤 3：检查账户是否被锁定（导航器 → 右键账户 → 属性）");
               Print("  → 步骤 4：尝试手动下一个买单，如果也失败，联系经纪商");
               Print("  → 步骤 5：确认账户类型是否允许自动交易");
              }
            // 如果是错误 4109，提供详细的解决建议
            else if(error == 4109)
              {
               Print("【错误 4109 解决方案】");
               Print("  → 可能原因 1：交易手数不符合要求（检查最小/最大手数和手数步长）");
               Print("  → 可能原因 2：交易品种在当前时间不可交易或被限制");
               Print("  → 可能原因 3：账户权限或资金不足");
               Print("  → 可能原因 4：经纪商要求必须设置止损/止盈");
               Print("  → 建议：检查 EA 参数设置，特别是手数（InpLots）和交易品种（InpSymbol）");
               Print("  → 建议：尝试手动下一个买单，如果也失败，联系经纪商");
              }
           }
         else
           {
            Print("【开多成功】Ticket=", ticket, " Lots=", lots, " Price=", askPrice);
            // 开仓成功，写入确认文件
            WriteCommandAck(cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令
           }
        }
      else if(StringCompare(InpBrokerId, shortBroker, false) == 0)
        {
         // SELL
         double bidPrice = MarketInfo(InpSymbol, MODE_BID);
         double point = MarketInfo(InpSymbol, MODE_POINT);
         double minLot = MarketInfo(InpSymbol, MODE_MINLOT);
         double maxLot = MarketInfo(InpSymbol, MODE_MAXLOT);
         double lotStep = MarketInfo(InpSymbol, MODE_LOTSTEP);
         
         // 检查手数是否有效
         if(lots < minLot)
           {
            Print("【开空失败】手数太小：", lots, " < 最小手数：", minLot);
            return;
           }
         if(lots > maxLot)
           {
            Print("【开空失败】手数太大：", lots, " > 最大手数：", maxLot);
            return;
           }
         
         // 规范化手数
         lots = MathFloor(lots / lotStep) * lotStep;
         
         Print("准备开空：Symbol=", InpSymbol, " Lots=", lots, " Bid=", bidPrice, " Slippage=", InpSlippage);
         
         // 交易前检查
         if(!IsTradeAllowed())
           {
            Print("【开空失败】交易被禁止 - 请检查：");
            Print("  1. MT4 工具栏的'自动交易'按钮是否已启用？");
            Print("  2. EA 属性中'允许自动交易'是否已勾选？");
            Print("  3. 账户是否被锁定或禁止交易？");
            Print("  4. 是否在允许的交易时间内？");
            return;
           }
         
         if(IsTradeContextBusy())
           {
            Print("【开空失败】交易上下文繁忙，请稍后重试");
            return;
           }
         
         int ticket = OrderSend(InpSymbol, OP_SELL, lots, bidPrice, InpSlippage, 0, 0,
                                "HedgeArb SELL", InpMagic, 0, clrRed);
         if(ticket < 0)
           {
            int error = GetLastError();
            string errorDesc = GetErrorDescription(error);
            Print("【开空失败】错误代码=", error, " (", errorDesc, ")");
            Print("   Symbol=", InpSymbol, " Lots=", lots, " Bid=", bidPrice, " Slippage=", InpSlippage);
            Print("   账户余额=", AccountBalance(), " 可用保证金=", AccountFreeMargin());
            
            // 如果是错误 133，提供详细的解决建议
            if(error == 133)
              {
               Print("【错误 133 解决方案】");
               Print("  → 步骤 1：检查 MT4 工具栏的'自动交易'按钮（绿色播放图标）是否已启用");
               Print("  → 步骤 2：右键点击 EA → 属性 → 确保'允许自动交易'已勾选");
               Print("  → 步骤 3：检查账户是否被锁定（导航器 → 右键账户 → 属性）");
               Print("  → 步骤 4：尝试手动下一个卖单，如果也失败，联系经纪商");
               Print("  → 步骤 5：确认账户类型是否允许自动交易");
              }
            // 如果是错误 4109，提供详细的解决建议
            else if(error == 4109)
              {
               Print("【错误 4109 解决方案】");
               Print("  → 可能原因 1：交易手数不符合要求（检查最小/最大手数和手数步长）");
               Print("  → 可能原因 2：交易品种在当前时间不可交易或被限制");
               Print("  → 可能原因 3：账户权限或资金不足");
               Print("  → 可能原因 4：经纪商要求必须设置止损/止盈");
               Print("  → 建议：检查 EA 参数设置，特别是手数（InpLots）和交易品种（InpSymbol）");
               Print("  → 建议：尝试手动下一个卖单，如果也失败，联系经纪商");
              }
           }
         else
           {
            Print("【开空成功】Ticket=", ticket, " Lots=", lots, " Price=", bidPrice);
            // 开仓成功，写入确认文件
            WriteCommandAck(cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令
           }
        }
      else
        {
         // 本终端不是指令中的 longBroker 或 shortBroker，不需要执行
         Print("【跳过开仓】指令中的 Broker 不是本终端：longBroker=", longBroker, " shortBroker=", shortBroker, " 本终端=", InpBrokerId);
         // 但也要标记为已处理，避免重复检查
         g_lastExecutedCommand = cmdLine;
        }
     }
   else if(action == "CLOSEALL")
     {
      // 仅关闭本 EA、自身品种的所有仓位
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != InpSymbol)
            continue;
         if(OrderMagicNumber() != InpMagic)
            continue;

         int type = OrderType();
         double lots = OrderLots();
         bool   closed = false;
         if(type == OP_BUY)
           {
            closed = OrderClose(OrderTicket(), lots, Bid, InpSlippage, clrYellow);
           }
         else if(type == OP_SELL)
           {
            closed = OrderClose(OrderTicket(), lots, Ask, InpSlippage, clrYellow);
           }

         if(!closed)
            Print("平仓失败 ticket=", OrderTicket(), " 错误代码=", GetLastError());
         else
            Print("平仓成功 ticket=", OrderTicket());
        }
      
      // 平仓指令执行后，清除指令文件和已执行记录，以便下次可以开新仓
      ClearCommandFile();
      g_lastExecutedCommand = ""; // 清除已执行记录，允许下次开新仓
     }
  }

//+------------------------------------------------------------------+
//| 写入指令确认文件（执行成功后调用）                                |
//+------------------------------------------------------------------+
void WriteCommandAck(const string cmdLine)
  {
   string fileName = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_" + InpBrokerId + ".txt";
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      FileWriteString(handle, cmdLine); // 写入已执行的指令
      FileClose(handle);
     }
  }

//+------------------------------------------------------------------+
//| 检查两个终端是否都已执行指令（主控端调用）                        |
//+------------------------------------------------------------------+
bool CheckBothAcked(const string cmdLine)
  {
   string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
   string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
   
   bool ackedA = false, ackedB = false;
   
   // 检查 A 的确认
   int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
   if(ha != INVALID_HANDLE)
     {
      string ackLine = FileReadString(ha);
      FileClose(ha);
      if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedA = true;
     }
   
   // 检查 B 的确认
   int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
   if(hb != INVALID_HANDLE)
     {
      string ackLine = FileReadString(hb);
      FileClose(hb);
      if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedB = true;
     }
   
   return(ackedA && ackedB);
  }

//+------------------------------------------------------------------+
//| 清除指令文件（主控端确认两个终端都执行成功后调用）                |
//+------------------------------------------------------------------+
void ClearCommandFile()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      FileWriteString(handle, ""); // 写入空字符串，清除指令
      FileClose(handle);
     }
  }

//+------------------------------------------------------------------+
//| 获取错误代码的详细描述                                            |
//+------------------------------------------------------------------+
string GetErrorDescription(int errorCode)
  {
   switch(errorCode)
     {
      case 0:     return "无错误";
      case 1:     return "无错误，但结果未知";
      case 2:     return "一般错误";
      case 3:     return "无效参数";
      case 4:     return "交易服务器繁忙";
      case 5:     return "旧版本的客户端终端";
      case 6:     return "与交易服务器无连接";
      case 7:     return "没有权限";
      case 8:     return "请求太频繁";
      case 9:     return "无效操作挂单";
      case 64:    return "账户被锁定";
      case 65:    return "无效账户";
      case 128:   return "交易超时";
      case 129:   return "无效价格";
      case 130:   return "无效止损";
      case 131:   return "无效交易量";
      case 132:   return "市场关闭";
      case 133:   return "交易被禁止";
      case 134:   return "没有足够的钱";
      case 135:   return "价格改变";
      case 136:   return "没有报价";
      case 137:   return "经纪商忙";
      case 138:   return "重新报价";
      case 139:   return "订单被锁定";
      case 140:   return "只允许买入";
      case 141:   return "请求太多";
      case 145:   return "修改被拒绝，订单太接近市场";
      case 146:   return "交易子系统忙";
      case 147:   return "使用到期日期的挂单被经纪商禁止";
      case 148:   return "挂单数量达到经纪商允许的上限";
      case 4109:  return "无效的交易参数（可能是止损/止盈距离、手数、或交易品种限制）";
      default:    return "未知错误";
     }
  }

