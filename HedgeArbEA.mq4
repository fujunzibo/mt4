//+------------------------------------------------------------------+
//|                                                 HedgeArbEA.mq4  |
//|                 双平台报价价差对冲套利 EA（MT4，本地文件通信）     |
//+------------------------------------------------------------------+
#property strict
#property copyright "Generated by AI"
#property link      ""
#property version   "1.00"
#property description "双经纪商 MT4 对冲套利：一边多、一边空，通过公共文件夹通信。"

//--- 输入参数
// 逻辑品种（用于文件名和主控通信，A/B 两端必须一致，例如统一用 "GOLD"）
input string   InpSymbol          = "EURUSD";   // 逻辑品种名（文件名的一部分，主控用这个识别）
// 实际交易品种（本终端 MT4 平台中的真实符号，例如 A 端 GLDUSD，B 端 XAUUSD）
input string   InpTradeSymbol     = "EURUSD";   // 实际交易品种（用于 MarketInfo / OrderSend / OrderClose）
input double   InpLots            = 1.0;        // 每边手数
input int      InpThresholdPips   = 5;          // 开仓触发点差（两平台报价差，单位：点）
input int      InpCloseTotalPips  = 10;         // 平仓条件：两边合计盈利 >= 多少点
input string   InpBrokerId        = "A";        // 本终端标识（例如：A / B）
input bool     InpIsMaster        = true;       // 是否为主控端（必须有一个为 true，一个为 false）
input int      InpMagic           = 20251126;   // EA Magic Number
input int      InpSlippage        = 3;          // 最大允许滑点（点）
input int      InpCheckIntervalMs = 500;        // 检查周期（毫秒）
input bool     InpUseTimer        = false;      // 使用定时器模式（周末测试用，市场开盘时设为 false）

//--- 常量 & 文件名基准
string g_priceFilePrefix   = "ArbPrice_";   // 报价文件前缀
string g_stateFilePrefix   = "ArbState_";   // 状态/指令文件前缀

//--- 运行时变量
datetime g_lastCheckTime = 0;
int      g_lastTickTimeMs = 0;
int      g_timerId = -1;
string   g_lastExecutedCommand = "";  // 记录最后执行的指令，避免重复执行
datetime g_lastFailedOpenTime = 0;    // 记录最后一次两边都失败的时间（用于防止立即重试）
datetime g_lastCommandSendTime = 0;   // 记录最后一次发送指令的时间（用于超时检测）
string   g_lastCommandSent = "";      // 记录最后一次发送的指令内容

//--- 工具函数声明
double   GetPointPip();
string   GetPriceFileName(const string brokerId);
string   GetStateFileName();
bool     WriteMyPrice();
bool     WriteMyAccountInfo();
bool     WriteMyPositions();
bool     WriteTradeHistory();
bool     ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB);
bool     IsMyBrokerA();
bool     HaveOpenHedgePositions();
void     CheckAndOpenHedge();
void     CheckAndCloseHedge();
double   CalcMyProfitPips();
bool     WriteMyProfit(double profitPips);
bool     ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB);
void     ExecCommands();
void     SendCommand(const string cmd);
void     WriteCommandAck(const string cmdLine);
bool     CheckBothAcked(const string cmdLine);
void     CleanupCompletedCommands();
void     CheckAndCancelFailedOpen(const string cmdLine);
void     CheckAndHandleFailedClose(const string cmdLine);
void     ClearCommandFile();
bool     CheckOtherSideFailed(const string cmdLine);
bool     CheckOtherSideSucceeded(const string cmdLine);
void     CloseAllMyPositions();
void     CloseAllMyPositionsWithRetry();

//+------------------------------------------------------------------+
//| EA 初始化                                                         |
//+------------------------------------------------------------------+
int OnInit()
  {
   if(StringLen(InpBrokerId) <= 0)
     {
      Print("错误：请在参数中设置 InpBrokerId（例如 A 或 B）");
      return(INIT_FAILED);
     }

   if(InpLots <= 0)
     {
      Print("错误：手数 InpLots 必须大于 0");
      return(INIT_FAILED);
     }

   if(Symbol() != InpTradeSymbol)
      Print("警告：当前图表品种(", Symbol(), ") 与参数 InpTradeSymbol(", InpTradeSymbol, ") 不一致，将按 InpTradeSymbol 交易。");

   Print("HedgeArbEA 初始化完成。BrokerId=", InpBrokerId,
         " IsMaster=", (InpIsMaster ? "true" : "false"),
         " LogicalSymbol=", InpSymbol,
         " TradeSymbol=", InpTradeSymbol,
         " UseTimer=", (InpUseTimer ? "true" : "false"));

   // 如果启用定时器模式，创建定时器（用于周末测试）
   if(InpUseTimer)
     {
      // 计算定时器间隔（秒），确保至少1秒
      int timerSeconds = (int)MathMax(1, InpCheckIntervalMs / 1000.0);
      if(timerSeconds < 1) timerSeconds = 1; // 双重保险，至少1秒
      
      Print("准备创建定时器：InpCheckIntervalMs=", InpCheckIntervalMs, "ms, 转换为秒=", timerSeconds);
      
      g_timerId = EventSetTimer(timerSeconds);
      if(g_timerId == -1)
        {
         int error = GetLastError();
         Print("【错误】定时器创建失败，错误代码=", error, " 尝试的间隔=", timerSeconds, "秒");
        }
      else
        {
         Print("【成功】定时器模式已启用，每 ", timerSeconds, " 秒执行一次，TimerId=", g_timerId);
         // 立即执行一次，测试是否能写入文件
         Print("立即执行一次测试写入...");
         ExecuteMainLogic();
        }
     }
   else
     {
      Print("【提示】未启用定时器模式，EA 将在市场有 Tick 时执行（周末市场休市时不会执行）");
      Print("【提示】如需周末测试，请将 InpUseTimer 设置为 true");
     }

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| EA 去初始化                                                       |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   // 删除定时器
   if(g_timerId != -1)
     {
      EventKillTimer();
      g_timerId = -1;
     }
   Print("HedgeArbEA 结束，BrokerId=", InpBrokerId);
  }

//+------------------------------------------------------------------+
//| 每个 Tick 调用                                                   |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 如果使用定时器模式，OnTick 不执行（由 OnTimer 执行）
   if(InpUseTimer)
      return;

   // 控制检查频率，避免 CPU 占用过高
   uint millis = GetTickCount();
   if((int)(millis - g_lastTickTimeMs) < InpCheckIntervalMs)
      return;
   g_lastTickTimeMs = (int)millis;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 定时器事件（用于周末测试）                                        |
//+------------------------------------------------------------------+
void OnTimer()
  {
   if(!InpUseTimer)
      return;

   // 执行主要逻辑
   ExecuteMainLogic();
  }

//+------------------------------------------------------------------+
//| 主要逻辑（从 OnTick 和 OnTimer 调用）                            |
//+------------------------------------------------------------------+
void ExecuteMainLogic()
  {
   static int execCount = 0;
   execCount++;
   
   // 每10次输出一次调试信息
   if(execCount % 10 == 1)
     {
      Print("ExecuteMainLogic 执行 #", execCount, " BrokerId=", InpBrokerId, " UseTimer=", (InpUseTimer ? "true" : "false"));
     }

   // 写入自己的报价
   WriteMyPrice();
   
   // 写入账户信息
   WriteMyAccountInfo();
   
   // 写入持仓信息
   WriteMyPositions();
   
   // 写入交易历史（每10次执行一次，避免过于频繁）
   static int historyWriteCount = 0;
   historyWriteCount++;
   if(historyWriteCount % 10 == 0)
     {
      WriteTradeHistory();
     }

   // 响应来自主控端的指令（开仓/平仓）
   ExecCommands();

   // 所有终端：如果有持仓，写入当前盈亏（用于平仓判断）
   if(HaveOpenHedgePositions())
     {
      double myPips = CalcMyProfitPips();
      WriteMyProfit(myPips);
     }

   // 主控端负责：判断是否开仓 & 是否平仓 & 清理已完成的指令
   if(InpIsMaster)
     {
      // 检查并清理已完成的指令
      CleanupCompletedCommands();
      
      CheckAndOpenHedge();
      CheckAndCloseHedge();
     }
  }

//+------------------------------------------------------------------+
//| 获得“1 点”对应的价格增量（有的品种 Point 是 0.00001，则 1 点=10*Point）|
//+------------------------------------------------------------------+
double GetPointPip()
  {
   // 通常 3/5 位小数的货币对：1 点 = 10 * Point
   if(Digits == 3 || Digits == 5)
      return(Point * 10);
   // 其他情况直接按 1 Point 作为 1 点
   return(Point);
  }

//+------------------------------------------------------------------+
//| 根据 BrokerId 生成报价文件名（公共文件夹）                       |
//+------------------------------------------------------------------+
string GetPriceFileName(const string brokerId)
  {
   string name = g_priceFilePrefix + InpSymbol + "_" + brokerId + ".csv";
   return(name);
  }

//+------------------------------------------------------------------+
//| 状态/指令文件名                                                  |
//+------------------------------------------------------------------+
string GetStateFileName()
  {
   string name = g_stateFilePrefix + InpSymbol + ".txt";
   return(name);
  }

//+------------------------------------------------------------------+
//| 写入本终端报价到公共文件夹                                      |
//+------------------------------------------------------------------+
bool WriteMyPrice()
  {
   double bid = MarketInfo(InpTradeSymbol, MODE_BID);
   double ask = MarketInfo(InpTradeSymbol, MODE_ASK);
   
   // 调试信息
   static int writeCount = 0;
   writeCount++;
   if(writeCount % 10 == 1) // 每10次输出一次，避免日志过多
     {
      Print("WriteMyPrice 调用 #", writeCount, " TradeSymbol=", InpTradeSymbol, " Bid=", bid, " Ask=", ask);
     }
   
   if(bid <= 0 || ask <= 0)
     {
      Print("警告：报价无效 Bid=", bid, " Ask=", ask);
      return(false);
     }

   string fileName = GetPriceFileName(InpBrokerId);
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开报价文件失败：", fileName, " 错误代码=", error);
      Print("公共文件夹路径检查：FILE_COMMON 标志已使用");
      return(false);
     }

   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(bid, Digits), DoubleToString(ask, Digits));
   FileClose(handle);
   
   if(writeCount % 10 == 1)
     {
      Print("报价文件写入成功：", fileName);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端账户信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyAccountInfo()
  {
   double bid = MarketInfo(InpTradeSymbol, MODE_BID);
   double ask = MarketInfo(InpTradeSymbol, MODE_ASK);
   
   // 调试信息
   static int accountWriteCount = 0;
   accountWriteCount++;
   if(accountWriteCount % 10 == 1)
     {
      Print("WriteMyAccountInfo 调用 #", accountWriteCount, " Bid=", bid, " Ask=", ask);
     }
   
   // 即使报价为0（市场休市），也写入账户信息（但使用上次有效报价或0）
   // 这样监控程序至少能看到账户信息
   if(bid <= 0 || ask <= 0)
     {
      if(accountWriteCount % 10 == 1)
        {
         Print("警告：报价无效，但继续写入账户信息（报价将显示为0）");
        }
      // 不返回，继续写入账户信息
      bid = 0;
      ask = 0;
     }

   int accountNumber = AccountNumber();
   double balance = AccountBalance();
   double equity = AccountEquity();
   double margin = AccountMargin();
   double freeMargin = AccountFreeMargin();
   int leverage = AccountLeverage();
   
   // 调试：输出杠杆信息
   if(accountWriteCount % 10 == 1)
     {
      Print("当前账户杠杆：", leverage, " (通过 AccountLeverage() 读取)");
     }

   string fileName = g_stateFilePrefix + "Account_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      int error = GetLastError();
      Print("【错误】打开账户信息文件失败：", fileName, " 错误代码=", error);
      return(false);
     }

   // 格式化报价（如果为0，显示为0.00000）
   string bidStr = (bid > 0) ? DoubleToString(bid, Digits) : "0.00000";
   string askStr = (ask > 0) ? DoubleToString(ask, Digits) : "0.00000";

   FileWrite(handle, 
             TimeToStr(TimeCurrent(), TIME_SECONDS),
             InpBrokerId,
             IntegerToString(accountNumber),
             DoubleToString(balance, 2),
             DoubleToString(equity, 2),
             DoubleToString(margin, 2),
             DoubleToString(freeMargin, 2),
             IntegerToString(leverage),
             bidStr,
             askStr);
   FileClose(handle);
   
   if(accountWriteCount % 10 == 1)
     {
      Print("账户信息文件写入成功：", fileName);
      Print("  账号=", accountNumber, " 余额=", balance, " 杠杆=", leverage);
      Print("  Bid=", bidStr, " Ask=", askStr);
     }
   
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入本终端持仓信息到公共文件夹                                    |
//+------------------------------------------------------------------+
bool WriteMyPositions()
  {
   string fileName = g_stateFilePrefix + "Positions_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头
   FileWrite(handle, "Ticket;Type;Lots;OpenPrice;CurrentPrice;Profit;Swap;Commission;Time");

   // 遍历所有持仓
   int positionCount = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
     double openPrice = OrderOpenPrice();
     double currentPrice = (type == OP_BUY) ? MarketInfo(InpTradeSymbol, MODE_BID) : MarketInfo(InpTradeSymbol, MODE_ASK);
      double profit = OrderProfit();
      double swap = OrderSwap();
      double commission = OrderCommission();
      datetime openTime = OrderOpenTime();

      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";
      FileWrite(handle, 
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(openPrice, Digits),
                DoubleToString(currentPrice, Digits),
                DoubleToString(profit, 2),
                DoubleToString(swap, 2),
                DoubleToString(commission, 2),
                TimeToString(openTime, TIME_DATE|TIME_MINUTES));
      positionCount++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 写入交易历史（最近的开仓/平仓记录）                                |
//+------------------------------------------------------------------+
bool WriteTradeHistory()
  {
   string fileName = g_stateFilePrefix + "History_" + InpSymbol + "_" + InpBrokerId + ".csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      return(false);
     }

   // 写入表头：增加开仓价和平仓价字段
   FileWrite(handle, "Time;Action;Ticket;Type;Lots;OpenPrice;ClosePrice;Profit;Comment");

   // 读取最近的交易历史（最多20条）
   int totalOrders = OrdersHistoryTotal();
   int count = 0;
   int maxRecords = 20;

   for(int i = totalOrders - 1; i >= 0 && count < maxRecords; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_HISTORY))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int ticket = OrderTicket();
      int type = OrderType();
      double lots = OrderLots();
      double openPrice = OrderOpenPrice();   // 开仓价
      double closePrice = OrderClosePrice(); // 平仓价
      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      datetime closeTime = OrderCloseTime();
      string comment = OrderComment();

      string action = "CLOSE";
      string typeStr = (type == OP_BUY) ? "BUY" : "SELL";

      FileWrite(handle,
                TimeToString(closeTime, TIME_DATE|TIME_MINUTES|TIME_SECONDS),
                action,
                IntegerToString(ticket),
                typeStr,
                DoubleToString(lots, 2),
                DoubleToString(openPrice, Digits),   // 开仓价
                DoubleToString(closePrice, Digits),  // 平仓价
                DoubleToString(profit, 2),
                comment);
      count++;
     }

   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端报价                                                 |
//+------------------------------------------------------------------+
bool ReadBothPrices(double &priceA, double &priceB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   priceA = 0;
   priceB = 0;

   string fileA = GetPriceFileName("A");
   string fileB = GetPriceFileName("B");

   // A
   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, bidStr, askStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         bidStr = FileReadString(ha);
         askStr = FileReadString(ha);
         if(bidStr != "" && askStr != "")
           {
            double bid = StrToDouble(bidStr);
            double ask = StrToDouble(askStr);
            priceA = (bid + ask) / 2.0;
            haveA = true;
           }
        }
      FileClose(ha);
     }

   // B
   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, bidStr2, askStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         bidStr2 = FileReadString(hb);
         askStr2 = FileReadString(hb);
         if(bidStr2 != "" && askStr2 != "")
           {
            double bid = StrToDouble(bidStr2);
            double ask = StrToDouble(askStr2);
            priceB = (bid + ask) / 2.0;
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 当前 EA 是否代表 Broker A                                        |
//+------------------------------------------------------------------+
bool IsMyBrokerA()
  {
   return(StringCompare(InpBrokerId, "A", false) == 0);
  }

//+------------------------------------------------------------------+
//| 检查是否已有对冲仓                                               |
//+------------------------------------------------------------------+
bool HaveOpenHedgePositions()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;
      // 只要本 EA 在该品种下有持仓，就认为有一组对冲在运行
      return(true);
     }
   return(false);
  }

//+------------------------------------------------------------------+
//| 主控端：检查是否需要开一组对冲仓                                 |
//+------------------------------------------------------------------+
void CheckAndOpenHedge()
  {
   // 如果已有对冲仓，则不再开新的（简单版本：每次只维护一组仓位）
   if(HaveOpenHedgePositions())
      return;
   
   // 检查是否有未完成的平仓指令（如果有，等待平仓完成后再开新仓）
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      string cmdLine = FileReadString(handle);
      FileClose(handle);
      if(StringLen(cmdLine) > 0)
        {
         string parts[4];
         int partCount = StringSplit(cmdLine, ';', parts);
         if(partCount > 0 && StringCompare(parts[0], "CLOSEALL", false) == 0)
           {
            // 有平仓指令未完成，等待平仓完成
            return;
           }
        }
     }

   double priceA, priceB;
   bool haveA, haveB;
   if(!ReadBothPrices(priceA, priceB, haveA, haveB))
      return;

   double pipSize = GetPointPip();
   if(pipSize <= 0)
      return;

   double diff = priceA - priceB; // A - B
   double diffPips = diff / pipSize;

   // 绝对价差达到阈值才考虑开仓
   if(MathAbs(diffPips) < InpThresholdPips)
      return;

   // 检查是否有未完成的开仓指令（如果有，等待完成后再发送新指令）
   // 重用上面已定义的 fileName 变量
   int handleCheck = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handleCheck != INVALID_HANDLE)
     {
      string existingCmd = FileReadString(handleCheck);
      FileClose(handleCheck);
      if(StringLen(existingCmd) > 0)
        {
         string parts[4];
         int partCount = StringSplit(existingCmd, ';', parts);
         if(partCount > 0 && StringCompare(parts[0], "OPEN", false) == 0)
           {
            // 有未完成的开仓指令，检查是否已经失败或成功
            string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
            string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
            bool failedA = false, failedB = false;
            bool ackedA = false, ackedB = false;
            
            int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
            if(ha != INVALID_HANDLE)
              {
               string ackLine = FileReadString(ha);
               FileClose(ha);
               if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, existingCmd) > 0)
                  failedA = true;
               else if(StringCompare(ackLine, existingCmd, false) == 0)
                  ackedA = true;
              }
            
            int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
            if(hb != INVALID_HANDLE)
              {
               string ackLine = FileReadString(hb);
               FileClose(hb);
               if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, existingCmd) > 0)
                  failedB = true;
               else if(StringCompare(ackLine, existingCmd, false) == 0)
                  ackedB = true;
              }
            
            // 如果两边都成功，说明指令已经完成，但指令文件没有被清除，清除它
            if(ackedA && ackedB)
              {
               Print("【开仓检查】检测到之前的开仓指令两边都已成功，但指令文件未被清除，清除指令文件");
               ClearCommandFile();
               // 清除确认文件
               if(FileIsExist(fileA, FILE_COMMON))
                  FileDelete(fileA, FILE_COMMON);
               if(FileIsExist(fileB, FILE_COMMON))
                  FileDelete(fileB, FILE_COMMON);
               // 重置变量
               if(InpIsMaster)
                 {
                  g_lastCommandSendTime = 0;
                  g_lastCommandSent = "";
                 }
               // 重置已执行指令记录（所有终端都需要重置）
               g_lastExecutedCommand = "";
              }
            // 如果两边都失败，清除指令文件，允许发送新指令（但需要等待一段时间）
            else if(failedA && failedB)
              {
               // 检查是否已经过了足够的时间（5秒）再允许发送新指令
               datetime currentTime = TimeCurrent();
               int secondsSinceLastFailure = (int)(currentTime - g_lastFailedOpenTime);
               
               if(secondsSinceLastFailure < 5)
                 {
                  Print("【开仓检查】检测到之前的开仓指令两边都失败，但距离上次失败仅 ", secondsSinceLastFailure, " 秒，等待 ", (5 - secondsSinceLastFailure), " 秒后再重试");
                  return; // 等待足够的时间再重试
                 }
               
               Print("【开仓检查】检测到之前的开仓指令两边都失败，且已等待 ", secondsSinceLastFailure, " 秒，清除指令文件，允许发送新指令");
               ClearCommandFile();
               // 清除确认文件
               if(FileIsExist(fileA, FILE_COMMON))
                  FileDelete(fileA, FILE_COMMON);
               if(FileIsExist(fileB, FILE_COMMON))
                  FileDelete(fileB, FILE_COMMON);
               // 重置失败时间和指令发送时间
               g_lastFailedOpenTime = 0;
               if(InpIsMaster)
                 {
                  g_lastCommandSendTime = 0;
                  g_lastCommandSent = "";
                 }
               // 重置已执行指令记录（所有终端都需要重置）
               g_lastExecutedCommand = "";
              }
            else
              {
               // 有未完成的指令且未完全失败，等待完成
               return;
              }
           }
        }
     }

   // 决定哪边做多哪边做空：
   // 如果 A 报价更高（A > B），则：在 A 做多，在 B 做空
   // 如果 A 报价更低（A < B），则：在 B 做多，在 A 做空
   string longBroker, shortBroker;
   if(diff > 0)
     {
      longBroker  = "A";
      shortBroker = "B";
     }
   else
     {
      longBroker  = "B";
      shortBroker = "A";
     }

   // 通过状态文件发送开仓指令：格式示例
   // OPEN;longBroker;shortBroker;lots
   string cmd = "OPEN;" + longBroker + ";" + shortBroker + ";" + DoubleToString(InpLots, 2);
   SendCommand(cmd);
   Print("发送开仓指令：", cmd, " 价差=", DoubleToString(diffPips, 1), " 点");
  }

//+------------------------------------------------------------------+
//| 计算本终端所有对冲仓的盈亏（以点为单位，按绝对值累加）           |
//+------------------------------------------------------------------+
double CalcMyProfitPips()
  {
   double totalPips = 0.0;
   double pipSize = GetPointPip();
   if(pipSize <= 0)
      return(0.0);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
     if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      double profit = OrderProfit() + OrderSwap() + OrderCommission();
      // 换算点数 = 盈利金额 / (手数 * 每tick货币价值) * (tickSize / pipSize)
      // 其中：tickValue是每tick的价值（对于1标准手），tickSize是每tick的价格增量，pipSize是每点的价格增量
     double tickValue = MarketInfo(InpTradeSymbol, MODE_TICKVALUE);
     double tickSize = MarketInfo(InpTradeSymbol, MODE_TICKSIZE);
      if(tickValue <= 0 || OrderLots() <= 0 || tickSize <= 0)
         continue;
      // 计算盈亏的tick数
      double profitTicks = profit / (OrderLots() * tickValue);
      // 将tick数转换为点数
      double pips = profitTicks * (tickSize / pipSize);
      totalPips += pips;
     }
   return(totalPips);
  }

//+------------------------------------------------------------------+
//| 写入本终端当前合计盈亏（点数）                                   |
//+------------------------------------------------------------------+
bool WriteMyProfit(double profitPips)
  {
   string fileName = g_stateFilePrefix + InpSymbol + "_" + InpBrokerId + "_profit.csv";
   int handle = FileOpen(fileName, FILE_CSV | FILE_WRITE | FILE_COMMON, ';');
   if(handle == INVALID_HANDLE)
     {
      Print("打开盈亏文件失败：", fileName, " 错误代码=", GetLastError());
      return(false);
     }
   FileWrite(handle, TimeToStr(TimeCurrent(), TIME_SECONDS), DoubleToString(profitPips, 2));
   FileClose(handle);
   return(true);
  }

//+------------------------------------------------------------------+
//| 读取 A/B 两端盈亏（点）                                          |
//+------------------------------------------------------------------+
bool ReadBothProfits(double &pipsA, double &pipsB, bool &haveA, bool &haveB)
  {
   haveA = false;
   haveB = false;
   pipsA = 0;
   pipsB = 0;

   string fileA = g_stateFilePrefix + InpSymbol + "_A_profit.csv";
   string fileB = g_stateFilePrefix + InpSymbol + "_B_profit.csv";

   int ha = FileOpen(fileA, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(ha != INVALID_HANDLE)
     {
      string ts, pipsStr;
      if(!FileIsEnding(ha))
        {
         ts = FileReadString(ha);
         pipsStr = FileReadString(ha);
         if(pipsStr != "")
           {
            pipsA = StrToDouble(pipsStr);
            haveA = true;
           }
        }
      FileClose(ha);
     }

   int hb = FileOpen(fileB, FILE_CSV | FILE_READ | FILE_COMMON, ';');
   if(hb != INVALID_HANDLE)
     {
      string ts2, pipsStr2;
      if(!FileIsEnding(hb))
        {
         ts2 = FileReadString(hb);
         pipsStr2 = FileReadString(hb);
         if(pipsStr2 != "")
           {
            pipsB = StrToDouble(pipsStr2);
            haveB = true;
           }
        }
      FileClose(hb);
     }

   return(haveA && haveB);
  }

//+------------------------------------------------------------------+
//| 主控端：检查是否满足总盈利点数平仓（自动平仓）                   |
//+------------------------------------------------------------------+
void CheckAndCloseHedge()
  {
   if(!HaveOpenHedgePositions())
      return;

   // 注意：各端的盈亏已经在 ExecuteMainLogic 中写入，这里不需要重复写入
   // 读取两端的盈亏
   double pipsA, pipsB;
   bool haveA, haveB;
   if(!ReadBothProfits(pipsA, pipsB, haveA, haveB))
     {
      Print("【平仓检查】无法读取两端的盈亏文件，等待下次检查");
      return;
     }

   // 计算两边合计盈利点数（A+B）
   double totalPips = pipsA + pipsB;

   // 打印当前盈亏状态（用于调试）
   Print("【平仓检查】A端盈亏=", DoubleToString(pipsA, 2), " 点，B端盈亏=", DoubleToString(pipsB, 2), 
         " 点，合计=", DoubleToString(totalPips, 2), " 点，目标=", IntegerToString(InpCloseTotalPips), " 点");

   // 当合计盈利达到目标点数时，自动平仓
   if(totalPips >= InpCloseTotalPips)
     {
      string cmd = "CLOSEALL;";
      SendCommand(cmd);
      Print("【自动平仓】合计盈利 ", DoubleToString(totalPips, 2), " 点 >= 目标 ", 
            IntegerToString(InpCloseTotalPips), " 点，已发送平仓指令");
     }
  }

//+------------------------------------------------------------------+
//| 清理已完成的指令（主控端调用）                                    |
//+------------------------------------------------------------------+
void CleanupCompletedCommands()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
      return;
   
   string cmdLine = FileReadString(handle);
   FileClose(handle);
   
   if(StringLen(cmdLine) <= 0)
      return;
   
   // 检查是否是 OPEN 或 CLOSEALL 指令
   string parts[4];
   int partCount = StringSplit(cmdLine, ';', parts);
   if(partCount > 0)
     {
      if(StringCompare(parts[0], "OPEN", false) == 0)
        {
         // 检查两个终端是否都已确认执行开仓
         if(CheckBothAcked(cmdLine))
           {
            // 两个终端都已执行，清除指令文件
            ClearCommandFile();
            Print("【指令清理】两个终端都已执行开仓指令，已清除指令文件");
            // 清除确认文件，为下次开仓做准备
            string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
            string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
            if(FileIsExist(fileA, FILE_COMMON))
              {
               FileDelete(fileA, FILE_COMMON);
               Print("【指令清理】已清除A端确认文件");
              }
            if(FileIsExist(fileB, FILE_COMMON))
              {
               FileDelete(fileB, FILE_COMMON);
               Print("【指令清理】已清除B端确认文件");
              }
            // 重置指令发送时间
            if(InpIsMaster)
              {
               g_lastCommandSendTime = 0;
               g_lastCommandSent = "";
              }
            // 重置已执行指令记录（所有终端都需要重置，以便下次可以执行新的OPEN指令）
            // 注意：g_lastExecutedCommand是每个终端自己的变量，需要在每个终端都重置
            // 这里只能重置主控端的，其他终端需要在ExecCommands中检测到指令文件被清除后重置
           }
         else
           {
            // 检查是否有一边失败，如果有，发送平仓指令给另一边
            CheckAndCancelFailedOpen(cmdLine);
           }
        }
      else if(StringCompare(parts[0], "CLOSEALL", false) == 0)
        {
         // 检查两个终端是否都已确认执行平仓
         if(CheckBothAcked(cmdLine))
           {
            // 两个终端都已执行平仓，清除指令文件
            ClearCommandFile();
            Print("【指令清理】两个终端都已成功平仓，已清除指令文件，可以开始新的开仓循环");
            // 清除确认文件，为下次开仓做准备
            string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
            string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
            if(FileIsExist(fileA, FILE_COMMON))
              {
               FileDelete(fileA, FILE_COMMON);
               Print("【指令清理】已清除A端确认文件");
              }
            if(FileIsExist(fileB, FILE_COMMON))
              {
               FileDelete(fileB, FILE_COMMON);
               Print("【指令清理】已清除B端确认文件");
              }
            // 重置指令发送时间和已执行指令记录
            if(InpIsMaster)
              {
               g_lastCommandSendTime = 0;
               g_lastCommandSent = "";
              }
            // 重置已执行指令记录（所有终端都需要重置，以便下次可以执行新的OPEN指令）
            g_lastExecutedCommand = "";
           }
         else
           {
            // 检查是否有一边平仓失败，如果有，继续重试（不清除指令）
            CheckAndHandleFailedClose(cmdLine);
            // 指令文件保留，下次执行时会继续尝试平仓
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| 检查并处理平仓失败的情况                                          |
//+------------------------------------------------------------------+
void CheckAndHandleFailedClose(const string cmdLine)
  {
   string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
   string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
   
   bool failedA = false, failedB = false;
   bool ackedA = false, ackedB = false;
   
   // 检查 A 的状态
   int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
   if(ha != INVALID_HANDLE)
     {
      string ackLine = FileReadString(ha);
      FileClose(ha);
      if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedA = true;
      else if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedA = true;
     }
   
   // 检查 B 的状态
   int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
   if(hb != INVALID_HANDLE)
     {
      string ackLine = FileReadString(hb);
      FileClose(hb);
      if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedB = true;
      else if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedB = true;
     }
   
   // 如果有一边平仓失败，记录状态（指令文件保留，下次继续重试）
   if(failedA || failedB)
     {
      Print("【平仓状态】检测到一边平仓失败：A=", (failedA ? "失败（重试中）" : (ackedA ? "成功" : "未确认")), 
            " B=", (failedB ? "失败（重试中）" : (ackedB ? "成功" : "未确认")));
      Print("  → 指令文件保留，将继续重试平仓，直到两边都成功");
     }
  }

//+------------------------------------------------------------------+
//| 检查并取消失败的开仓（如果一边失败，平掉另一边已开的仓）          |
//+------------------------------------------------------------------+
void CheckAndCancelFailedOpen(const string cmdLine)
  {
   string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
   string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
   
   bool failedA = false, failedB = false;
   bool ackedA = false, ackedB = false;
   
   // 检查 A 的状态
   int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
   if(ha != INVALID_HANDLE)
     {
      string ackLine = FileReadString(ha);
      FileClose(ha);
      if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedA = true;
      else if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedA = true;
     }
   
   // 检查 B 的状态
   int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
   if(hb != INVALID_HANDLE)
     {
      string ackLine = FileReadString(hb);
      FileClose(hb);
      if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedB = true;
      else if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedB = true;
     }
   
   // 如果一边失败，另一边成功，发送平仓指令
   if((failedA && ackedB) || (failedB && ackedA))
     {
      Print("【对冲失败处理】检测到一边开仓失败，另一边已开仓，发送平仓指令取消对冲");
      string closeCmd = "CLOSEALL;";
      SendCommand(closeCmd);
      // 清除开仓指令，避免重复尝试
      ClearCommandFile();
      // 重置已执行指令记录（所有终端都需要重置）
      g_lastExecutedCommand = "";
     }
   // 如果一边失败，另一边未确认，检查是否超时（5秒）
   else if((failedA && !ackedB && !failedB) || (failedB && !ackedA && !failedA))
     {
      datetime currentTime = TimeCurrent();
      int secondsSinceCommand = (int)(currentTime - g_lastCommandSendTime);
      
      // 如果指令发送时间超过5秒，且另一边仍未确认，认为另一边可能没有响应，清除指令文件
      if(secondsSinceCommand >= 5)
        {
         Print("【对冲失败处理】检测到一边开仓失败，另一边未确认，且已超时 ", secondsSinceCommand, " 秒");
         Print("  → 认为另一边可能没有响应或执行失败，清除指令文件，避免死循环");
         // 清除开仓指令，避免主控端不断重复发送
         ClearCommandFile();
         // 清除确认文件，为下次尝试做准备
         if(FileIsExist(fileA, FILE_COMMON))
            FileDelete(fileA, FILE_COMMON);
         if(FileIsExist(fileB, FILE_COMMON))
            FileDelete(fileB, FILE_COMMON);
         // 记录失败时间并重置指令发送时间
         if(InpIsMaster)
           {
            g_lastFailedOpenTime = TimeCurrent();
            g_lastCommandSendTime = 0;
            g_lastCommandSent = "";
           }
         // 重置已执行指令记录（所有终端都需要重置）
         g_lastExecutedCommand = "";
         // 重置已执行指令记录（所有终端都需要重置）
         g_lastExecutedCommand = "";
        }
      else
        {
         Print("【对冲失败处理】检测到一边开仓失败，另一边未确认，等待中（已等待 ", secondsSinceCommand, " 秒，最多等待5秒）");
        }
     }
   // 如果两边都失败，清除指令文件，避免死循环
   else if(failedA && failedB)
     {
      Print("【对冲失败处理】检测到两边都开仓失败，清除指令文件，避免死循环");
      Print("  → A=失败 B=失败，可能是交易环境问题，等待5秒后重试");
      // 记录失败时间（只有主控端记录）
      if(InpIsMaster)
         g_lastFailedOpenTime = TimeCurrent();
      // 清除开仓指令，避免主控端不断重复发送
      ClearCommandFile();
      // 清除确认文件，为下次尝试做准备
      if(FileIsExist(fileA, FILE_COMMON))
         FileDelete(fileA, FILE_COMMON);
      if(FileIsExist(fileB, FILE_COMMON))
         FileDelete(fileB, FILE_COMMON);
      // 重置指令发送时间
      if(InpIsMaster)
        {
         g_lastCommandSendTime = 0;
         g_lastCommandSent = "";
        }
      // 重置已执行指令记录（所有终端都需要重置）
      g_lastExecutedCommand = "";
     }
  }

//+------------------------------------------------------------------+
//| 向状态文件写入指令（覆盖写入，最后一条为最新）                   |
//+------------------------------------------------------------------+
void SendCommand(const string cmd)
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle == INVALID_HANDLE)
     {
      Print("打开状态文件失败：", fileName, " 错误代码=", GetLastError());
      return;
     }
   FileWriteString(handle, cmd);
   FileClose(handle);
   
   // 记录指令发送时间和内容（只有主控端记录）
   if(InpIsMaster)
     {
      g_lastCommandSendTime = TimeCurrent();
      g_lastCommandSent = cmd;
     }
  }

//+------------------------------------------------------------------+
//| 读取并执行针对本终端的指令                                       |
//+------------------------------------------------------------------+
void ExecCommands()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
     {
      // 文件不存在，说明指令已经被清除，重置已执行指令记录
      if(StringLen(g_lastExecutedCommand) > 0)
        {
         Print("【ExecCommands】指令文件不存在，重置已执行指令记录");
         g_lastExecutedCommand = "";
        }
      return; // 文件可能暂时不存在，忽略
     }

   string cmdLine = FileReadString(handle);
   FileClose(handle);

   if(StringLen(cmdLine) <= 0)
     {
      // 指令文件为空，说明指令已经被清除，重置已执行指令记录
      if(StringLen(g_lastExecutedCommand) > 0)
        {
         Print("【ExecCommands】指令文件为空，重置已执行指令记录");
         g_lastExecutedCommand = "";
        }
      return;
     }

   // ==== 强制调试日志：无论如何先把收到的指令打印出来，便于排查 ====
   Print("【ExecCommands 调用】BrokerId=", InpBrokerId,
         " 收到指令: '", cmdLine, "'");

   // 简单解析：用分号分隔
   string parts[4];
   int partCount = StringSplit(cmdLine, ';', parts);
   if(partCount <= 0)
      return;

   string action = parts[0];

   if(action == "OPEN" && partCount >= 4)
     {
      // 记录当前 OPEN 指令解析结果
      Print("【ExecCommands-OPEN】BrokerId=", InpBrokerId,
            " longBroker=", parts[1],
            " shortBroker=", parts[2],
            " lots(str)=", parts[3]);
      // 检查是否已经执行过这个指令（避免重复执行）
      if(StringCompare(cmdLine, g_lastExecutedCommand, false) == 0)
         return; // 已经执行过，跳过
      
      // 检查是否已经有持仓（避免重复开仓）
      if(HaveOpenHedgePositions())
        {
         Print("【跳过开仓】已有持仓，等待平仓后再开新仓");
         g_lastExecutedCommand = cmdLine; // 标记为已处理，避免重复检查
         return;
        }
      
      string longBroker  = parts[1];
      string shortBroker = parts[2];
      double lots        = StrToDouble(parts[3]);

      if(lots <= 0)
        {
         Print("【ExecCommands-OPEN】lots 解析结果 <= 0，忽略本次指令。lots(str)=", parts[3],
               " lots(double)=", lots);
         return;
        }

      // 判断本端该做多还是做空
      if(StringCompare(InpBrokerId, longBroker, false) == 0)
        {
         // BUY
         double askPrice = MarketInfo(InpTradeSymbol, MODE_ASK);
         double point = MarketInfo(InpTradeSymbol, MODE_POINT);
         double minLot = MarketInfo(InpTradeSymbol, MODE_MINLOT);
         double maxLot = MarketInfo(InpTradeSymbol, MODE_MAXLOT);
         double lotStep = MarketInfo(InpTradeSymbol, MODE_LOTSTEP);
         
         // 检查手数是否有效
         if(lots < minLot)
           {
            Print("【开多失败】手数太小：", lots, " < 最小手数：", minLot);
            Print("【调试】TradeSymbol=", InpTradeSymbol,
                  " minLot=", minLot,
                  " maxLot=", maxLot,
                  " lotStep=", lotStep);
            return;
           }
         if(lots > maxLot)
           {
            Print("【开多失败】手数太大：", lots, " > 最大手数：", maxLot);
            Print("【调试】TradeSymbol=", InpTradeSymbol,
                  " minLot=", minLot,
                  " maxLot=", maxLot,
                  " lotStep=", lotStep);
            return;
           }
         
         // 规范化手数
         lots = MathFloor(lots / lotStep) * lotStep;
         
         // 刷新报价，确保使用最新价格
         RefreshRates();
         askPrice = MarketInfo(InpTradeSymbol, MODE_ASK);
         if(askPrice <= 0)
           {
            Print("【开多失败】无法获取有效报价：Ask=", askPrice);
            return;
           }
         
         Print("准备开多：TradeSymbol=", InpTradeSymbol, " Lots=", lots, " Ask=", askPrice, " Slippage=", InpSlippage);
         
         // 交易前检查
         if(!IsTradeAllowed())
           {
            Print("【开多失败】交易被禁止 - 请检查：");
            Print("  1. MT4 工具栏的'自动交易'按钮是否已启用？");
            Print("  2. EA 属性中'允许自动交易'是否已勾选？");
            Print("  3. 账户是否被锁定或禁止交易？");
            Print("  4. 是否在允许的交易时间内？");
            Print("【调试】IsTradeAllowed=false, TradeSymbol=", InpTradeSymbol,
                  " 当前服务器时间=", TimeToStr(TimeCurrent(), TIME_DATE|TIME_SECONDS));
            Print("【诊断】账户信息：账号=", AccountNumber(), 
                  " 余额=", AccountBalance(), 
                  " 杠杆=", AccountLeverage());
            Print("【诊断】请按照《错误133排查指南.md》逐步检查！");
            return;
           }
         
         if(IsTradeContextBusy())
           {
            Print("【开多失败】交易上下文繁忙，请稍后重试");
            Print("【调试】IsTradeContextBusy=true, TradeSymbol=", InpTradeSymbol);
            return;
           }
         
         // 在 OrderSend 之前，再次确认交易允许状态
         if(!IsTradeAllowed())
           {
            Print("【开多失败-二次检查】IsTradeAllowed() 返回 false，但之前检查通过，可能是状态变化");
            Print("【调试】建议：等待几秒后重试，或检查是否有其他程序在占用交易上下文");
            return;
           }
         
         // 清除之前的错误代码
         ResetLastError();
         
         // 添加重试机制（最多重试3次）
         int ticket = -1;
         int maxRetries = 3;
         for(int retry = 0; retry < maxRetries; retry++)
           {
            if(retry > 0)
              {
               Print("【开多重试】第 ", retry + 1, " 次尝试，等待 ", retry * 200, "ms...");
               Sleep(retry * 200); // 递增等待时间
               // 再次检查交易上下文
               if(IsTradeContextBusy())
                 {
                  Print("【开多重试】交易上下文仍然繁忙，继续等待...");
                  continue;
                 }
               // 刷新报价并重新获取价格
               RefreshRates();
               askPrice = MarketInfo(InpTradeSymbol, MODE_ASK);
               if(askPrice <= 0)
                 {
                  Print("【开多重试】刷新报价失败，Ask=", askPrice);
                  continue;
                 }
               Print("【开多重试】刷新报价：Ask=", askPrice);
              }
            
            // 再次确认交易允许状态
            if(!IsTradeAllowed())
              {
               Print("【开多重试】IsTradeAllowed() 返回 false，跳过本次重试");
               continue;
              }
            
            // 规范化价格到正确的精度
            askPrice = NormalizeDouble(askPrice, Digits);
            
            // 验证价格是否有效
            double currentAsk = MarketInfo(InpTradeSymbol, MODE_ASK);
            double priceDiff = MathAbs(askPrice - currentAsk);
            double maxPriceDiff = MarketInfo(InpTradeSymbol, MODE_POINT) * 10; // 允许10个点的差异
            
            if(priceDiff > maxPriceDiff)
              {
               Print("【开多重试】价格差异过大：askPrice=", askPrice, " currentAsk=", currentAsk, " diff=", priceDiff);
               // 使用最新价格
               askPrice = NormalizeDouble(currentAsk, Digits);
               Print("【开多重试】使用最新价格：", askPrice);
              }
            
            ticket = OrderSend(InpTradeSymbol, OP_BUY, lots, askPrice, InpSlippage, 0, 0,
                                "HedgeArb BUY", InpMagic, 0, clrBlue);
            if(ticket >= 0)
               break; // 成功，退出重试循环
            
            // 立即获取错误代码（在 OrderSend 失败后立即调用）
            int error = GetLastError();
            ResetLastError(); // 清除错误代码，避免影响下次判断
            
            Print("【开多重试】OrderSend 失败，错误代码=", error);
            
            // 如果错误代码为 0，可能是订单被拒绝但没有返回具体错误
            if(error == 0)
              {
               Print("【开多重试】错误代码=0（无错误），但订单失败，可能是：");
               Print("  1. 经纪商要求必须设置止损/止盈");
               Print("  2. 交易品种在当前时间不可交易");
               Print("  3. 账户权限限制");
               Print("  4. 价格已过期（尝试刷新报价后重试）");
               // 对于错误 0，也尝试重试（可能是临时性问题）
               if(retry < maxRetries - 1)
                 {
                  Print("【开多重试】将尝试重试...");
                  continue;
                 }
              }
            
            // 错误 133 也尝试重试（可能是临时性问题）
            if(error == 133)
              {
               Print("【开多重试】错误 133（交易被禁止），可能是临时性问题，将重试...");
               continue; // 继续重试
              }
            
            if(error != 4 && error != 6 && error != 137 && error != 146) // 如果不是临时性错误，不重试
               break;
            
            Print("【开多重试】临时性错误 ", error, "，将重试...");
           }
         
         if(ticket < 0)
           {
            int error = GetLastError();
            string errorDesc = GetErrorDescription(error);
            Print("【开多失败】错误代码=", error, " (", errorDesc, ")");
            Print("   TradeSymbol=", InpTradeSymbol, " Lots=", lots, " Ask=", askPrice, " Slippage=", InpSlippage);
            Print("   账户余额=", AccountBalance(), " 可用保证金=", AccountFreeMargin());
            Print("【调试】AccountEquity=", AccountEquity(),
                  " MarginFree=", AccountFreeMargin(),
                  " Margin=", AccountMargin());
            Print("【调试】IsTradeAllowed()=", IsTradeAllowed(), 
                  " IsTradeContextBusy()=", IsTradeContextBusy());
            // 统计本EA的持仓数
            int myPosCount = 0;
            for(int j = OrdersTotal() - 1; j >= 0; j--)
              {
               if(OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
                 {
                  if(OrderSymbol() == InpTradeSymbol && OrderMagicNumber() == InpMagic)
                     myPosCount++;
                 }
              }
            Print("【调试】当前持仓数=", OrdersTotal(), " 本EA持仓数=", myPosCount);
            
            // 开仓失败，写入失败确认（让主控端知道这边失败了）
            WriteCommandAck("FAILED:" + cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令（虽然失败了）
            
            // ==== 严格保护：开仓失败后，立即检查另一边是否成功，如果成功，立即发送平仓指令 ====
            Sleep(100); // 等待 100ms，确保另一边有时间写入确认文件
            if(InpIsMaster && CheckOtherSideSucceeded(cmdLine))
              {
               Print("【严格保护】本端开仓失败，但检测到另一边已开仓，立即发送平仓指令，严禁单边开仓！");
               string closeCmd = "CLOSEALL;";
               SendCommand(closeCmd);
               ClearCommandFile(); // 清除开仓指令，避免重复尝试
              }
            
            // 如果是错误 133，提供详细的解决建议
            if(error == 133)
              {
               Print("【错误 133 解决方案】");
               Print("  → 步骤 1：检查 MT4 工具栏的'自动交易'按钮（绿色播放图标）是否已启用");
               Print("  → 步骤 2：右键点击 EA → 属性 → 确保'允许自动交易'已勾选");
               Print("  → 步骤 3：检查账户是否被锁定（导航器 → 右键账户 → 属性）");
               Print("  → 步骤 4：尝试手动下一个买单，如果也失败，联系经纪商");
               Print("  → 步骤 5：确认账户类型是否允许自动交易");
               Print("【诊断】账户信息：账号=", AccountNumber(), 
                     " 余额=", AccountBalance(), 
                     " 杠杆=", AccountLeverage(),
                     " 服务器时间=", TimeToStr(TimeCurrent(), TIME_DATE|TIME_SECONDS));
               Print("【诊断】如果手动下单可以，但EA下单失败，可能是：");
               Print("  1. 交易上下文被其他操作占用（等待几秒后重试）");
               Print("  2. MT4版本或经纪商的特殊限制（联系经纪商）");
               Print("  3. EA执行频率过高导致服务器限制（降低InpCheckIntervalMs）");
               Print("【诊断】详细排查步骤请参考：错误133排查指南.md");
              }
            // 如果是错误 4109，提供详细的解决建议
            else if(error == 4109)
              {
               Print("【错误 4109 解决方案】");
               Print("  → 可能原因 1：交易手数不符合要求（检查最小/最大手数和手数步长）");
               Print("  → 可能原因 2：交易品种在当前时间不可交易或被限制");
               Print("  → 可能原因 3：账户权限或资金不足");
               Print("  → 可能原因 4：经纪商要求必须设置止损/止盈");
               Print("  → 建议：检查 EA 参数设置，特别是手数（InpLots）和交易品种（InpSymbol）");
               Print("  → 建议：尝试手动下一个买单，如果也失败，联系经纪商");
              }
           }
         else
           {
            Print("【开多成功】Ticket=", ticket, " Lots=", lots, " Price=", askPrice);
            // 开仓成功，写入确认文件
            WriteCommandAck(cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令
            
            // ==== 严格保护：A和B必须同时成功，不能等待；若不成功，则本次开仓失败 ====
            // 等待文件写入完成（给文件系统时间刷新）
            Sleep(50);
            
            // 多次检查，增加检测成功率（最多检查5次，每次等待200ms，总共最多等待1秒）
            bool otherSideSucceeded = false;
            bool otherSideFailed = false;
            
            for(int checkRetry = 0; checkRetry < 5; checkRetry++)
              {
               if(checkRetry > 0)
                 {
                  Sleep(200); // 每次等待200ms
                 }
               
               // 检查另一边是否成功
               if(CheckOtherSideSucceeded(cmdLine))
                 {
                  otherSideSucceeded = true;
                  Print("【严格保护】检测到另一边也已成功开仓，两边同时成功，保留持仓（检查次数=", checkRetry + 1, "，等待时间=", checkRetry * 200, "ms）");
                  break;
                 }
               // 检查另一边是否失败
               else if(CheckOtherSideFailed(cmdLine))
                 {
                  otherSideFailed = true;
                  Print("【严格保护】检测到另一边开仓失败，本次开仓失败，立即平掉本端已开的仓位！（检查次数=", checkRetry + 1, "，等待时间=", checkRetry * 200, "ms）");
                  break;
                 }
               else
                 {
                  // 继续等待和检查
                  Print("【严格保护】检查次数=", checkRetry + 1, "，另一边尚未确认，继续等待...");
                 }
              }
            
            // 如果多次检查后，另一边既没有成功也没有失败，认为本次开仓失败
            if(!otherSideSucceeded && !otherSideFailed)
              {
               Print("【严格保护】1秒后另一边仍未成功确认，本次开仓失败，立即平掉本端已开的仓位！");
               Print("  → A和B必须同时成功，本次开仓失败，具备条件后再重新开仓");
              }
            
            // 如果另一边没有成功，立即平仓（本次开仓失败）
            if(!otherSideSucceeded)
              {
               Print("【严格保护】A和B必须同时成功，本次开仓失败，立即平掉本端已开的仓位！");
               // 立即平掉本端所有持仓（带重试机制）
               CloseAllMyPositionsWithRetry();
               // 验证是否真的平掉了
               if(HaveOpenHedgePositions())
                 {
                  Print("【严格保护-警告】平仓后仍有持仓，继续重试平仓...");
                  Sleep(300);
                  CloseAllMyPositionsWithRetry();
                  // 再次验证
                  if(HaveOpenHedgePositions())
                    {
                     Print("【严格保护-严重警告】平仓失败，仍有持仓！请手动检查！");
                    }
                 }
               // 清除确认，让主控知道本端已经平仓
               WriteCommandAck("FAILED:" + cmdLine);
              }
           }
        }
      else if(StringCompare(InpBrokerId, shortBroker, false) == 0)
        {
         // SELL
         double bidPrice = MarketInfo(InpTradeSymbol, MODE_BID);
         double point = MarketInfo(InpTradeSymbol, MODE_POINT);
         double minLot = MarketInfo(InpTradeSymbol, MODE_MINLOT);
         double maxLot = MarketInfo(InpTradeSymbol, MODE_MAXLOT);
         double lotStep = MarketInfo(InpTradeSymbol, MODE_LOTSTEP);
         
         // 检查手数是否有效
         if(lots < minLot)
           {
            Print("【开空失败】手数太小：", lots, " < 最小手数：", minLot);
            Print("【调试】TradeSymbol=", InpTradeSymbol,
                  " minLot=", minLot,
                  " maxLot=", maxLot,
                  " lotStep=", lotStep);
            return;
           }
         if(lots > maxLot)
           {
            Print("【开空失败】手数太大：", lots, " > 最大手数：", maxLot);
            Print("【调试】TradeSymbol=", InpTradeSymbol,
                  " minLot=", minLot,
                  " maxLot=", maxLot,
                  " lotStep=", lotStep);
            return;
           }
         
         // 规范化手数
         lots = MathFloor(lots / lotStep) * lotStep;
         
         // 刷新报价，确保使用最新价格
         RefreshRates();
         bidPrice = MarketInfo(InpTradeSymbol, MODE_BID);
         if(bidPrice <= 0)
           {
            Print("【开空失败】无法获取有效报价：Bid=", bidPrice);
            return;
           }
         
         // 规范化价格到正确的精度
         bidPrice = NormalizeDouble(bidPrice, Digits);
         
         Print("准备开空：TradeSymbol=", InpTradeSymbol, " Lots=", lots, " Bid=", bidPrice, " Slippage=", InpSlippage, " Digits=", Digits);
         
         // 交易前检查
         if(!IsTradeAllowed())
           {
            Print("【开空失败】交易被禁止 - 请检查：");
            Print("  1. MT4 工具栏的'自动交易'按钮是否已启用？");
            Print("  2. EA 属性中'允许自动交易'是否已勾选？");
            Print("  3. 账户是否被锁定或禁止交易？");
            Print("  4. 是否在允许的交易时间内？");
            Print("【调试】IsTradeAllowed=false, TradeSymbol=", InpTradeSymbol,
                  " 当前服务器时间=", TimeToStr(TimeCurrent(), TIME_DATE|TIME_SECONDS));
            Print("【诊断】账户信息：账号=", AccountNumber(), 
                  " 余额=", AccountBalance(), 
                  " 杠杆=", AccountLeverage());
            Print("【诊断】请按照《错误133排查指南.md》逐步检查！");
            return;
           }
         
         if(IsTradeContextBusy())
           {
            Print("【开空失败】交易上下文繁忙，请稍后重试");
            Print("【调试】IsTradeContextBusy=true, TradeSymbol=", InpTradeSymbol);
            return;
           }
         
         // 在 OrderSend 之前，再次确认交易允许状态
         if(!IsTradeAllowed())
           {
            Print("【开空失败-二次检查】IsTradeAllowed() 返回 false，但之前检查通过，可能是状态变化");
            Print("【调试】建议：等待几秒后重试，或检查是否有其他程序在占用交易上下文");
            return;
           }
         
         // 清除之前的错误代码
         ResetLastError();
         
         // 添加重试机制（最多重试3次）
         int ticket = -1;
         int maxRetries = 3;
         for(int retry = 0; retry < maxRetries; retry++)
           {
            if(retry > 0)
              {
               Print("【开空重试】第 ", retry + 1, " 次尝试，等待 ", retry * 200, "ms...");
               Sleep(retry * 200); // 递增等待时间
               // 再次检查交易上下文
               if(IsTradeContextBusy())
                 {
                  Print("【开空重试】交易上下文仍然繁忙，继续等待...");
                  continue;
                 }
               // 刷新报价并重新获取价格
               RefreshRates();
               bidPrice = MarketInfo(InpTradeSymbol, MODE_BID);
               if(bidPrice <= 0)
                 {
                  Print("【开空重试】刷新报价失败，Bid=", bidPrice);
                  continue;
                 }
               Print("【开空重试】刷新报价：Bid=", bidPrice);
              }
            
            // 再次确认交易允许状态
            if(!IsTradeAllowed())
              {
               Print("【开空重试】IsTradeAllowed() 返回 false，跳过本次重试");
               continue;
              }
            
            // 规范化价格到正确的精度
            bidPrice = NormalizeDouble(bidPrice, Digits);
            
            // 验证价格是否有效
            double currentBid = MarketInfo(InpTradeSymbol, MODE_BID);
            double priceDiff = MathAbs(bidPrice - currentBid);
            double maxPriceDiff = MarketInfo(InpTradeSymbol, MODE_POINT) * 10; // 允许10个点的差异
            
            if(priceDiff > maxPriceDiff)
              {
               Print("【开空重试】价格差异过大：bidPrice=", bidPrice, " currentBid=", currentBid, " diff=", priceDiff);
               // 使用最新价格
               bidPrice = NormalizeDouble(currentBid, Digits);
               Print("【开空重试】使用最新价格：", bidPrice);
              }
            
            ticket = OrderSend(InpTradeSymbol, OP_SELL, lots, bidPrice, InpSlippage, 0, 0,
                                "HedgeArb SELL", InpMagic, 0, clrRed);
            if(ticket >= 0)
               break; // 成功，退出重试循环
            
            // 立即获取错误代码（在 OrderSend 失败后立即调用）
            int error = GetLastError();
            ResetLastError(); // 清除错误代码，避免影响下次判断
            
            Print("【开空重试】OrderSend 失败，错误代码=", error);
            
            // 如果错误代码为 0，可能是订单被拒绝但没有返回具体错误
            if(error == 0)
              {
               Print("【开空重试】错误代码=0（无错误），但订单失败，可能是：");
               Print("  1. 经纪商要求必须设置止损/止盈");
               Print("  2. 交易品种在当前时间不可交易");
               Print("  3. 账户权限限制");
               Print("  4. 价格已过期（尝试刷新报价后重试）");
               // 对于错误 0，也尝试重试（可能是临时性问题）
               if(retry < maxRetries - 1)
                 {
                  Print("【开空重试】将尝试重试...");
                  continue;
                 }
              }
            
            // 错误 133 也尝试重试（可能是临时性问题）
            if(error == 133)
              {
               Print("【开空重试】错误 133（交易被禁止），可能是临时性问题，将重试...");
               continue; // 继续重试
              }
            
            if(error != 4 && error != 6 && error != 137 && error != 146) // 如果不是临时性错误，不重试
               break;
            
            Print("【开空重试】临时性错误 ", error, "，将重试...");
           }
         
         if(ticket < 0)
           {
            // 立即获取错误代码
            int error = GetLastError();
            // 如果错误代码为 0，尝试再次获取（可能是延迟）
            if(error == 0)
              {
               Sleep(10);
               error = GetLastError();
              }
            string errorDesc = GetErrorDescription(error);
            Print("【开空失败】错误代码=", error, " (", errorDesc, ")");
            Print("   TradeSymbol=", InpTradeSymbol, " Lots=", lots, " Bid=", bidPrice, " Slippage=", InpSlippage);
            Print("   账户余额=", AccountBalance(), " 可用保证金=", AccountFreeMargin());
            Print("【调试】AccountEquity=", AccountEquity(),
                  " MarginFree=", AccountFreeMargin(),
                  " Margin=", AccountMargin());
            Print("【调试】IsTradeAllowed()=", IsTradeAllowed(), 
                  " IsTradeContextBusy()=", IsTradeContextBusy());
            // 统计本EA的持仓数
            int myPosCount = 0;
            for(int j = OrdersTotal() - 1; j >= 0; j--)
              {
               if(OrderSelect(j, SELECT_BY_POS, MODE_TRADES))
                 {
                  if(OrderSymbol() == InpTradeSymbol && OrderMagicNumber() == InpMagic)
                     myPosCount++;
                 }
              }
            Print("【调试】当前持仓数=", OrdersTotal(), " 本EA持仓数=", myPosCount);
            
            // 开仓失败，写入失败确认（让主控端知道这边失败了）
            WriteCommandAck("FAILED:" + cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令（虽然失败了）
            
            // ==== 严格保护：开仓失败后，立即检查另一边是否成功，如果成功，立即发送平仓指令 ====
            Sleep(100); // 等待 100ms，确保另一边有时间写入确认文件
            if(InpIsMaster && CheckOtherSideSucceeded(cmdLine))
              {
               Print("【严格保护】本端开仓失败，但检测到另一边已开仓，立即发送平仓指令，严禁单边开仓！");
               string closeCmd = "CLOSEALL;";
               SendCommand(closeCmd);
               ClearCommandFile(); // 清除开仓指令，避免重复尝试
              }
            
            // 如果是错误 133，提供详细的解决建议
            if(error == 133)
              {
               Print("【错误 133 解决方案】");
               Print("  → 步骤 1：检查 MT4 工具栏的'自动交易'按钮（绿色播放图标）是否已启用");
               Print("  → 步骤 2：右键点击 EA → 属性 → 确保'允许自动交易'已勾选");
               Print("  → 步骤 3：检查账户是否被锁定（导航器 → 右键账户 → 属性）");
               Print("  → 步骤 4：尝试手动下一个卖单，如果也失败，联系经纪商");
               Print("  → 步骤 5：确认账户类型是否允许自动交易");
               Print("【诊断】账户信息：账号=", AccountNumber(), 
                     " 余额=", AccountBalance(), 
                     " 杠杆=", AccountLeverage(),
                     " 服务器时间=", TimeToStr(TimeCurrent(), TIME_DATE|TIME_SECONDS));
               Print("【诊断】如果手动下单可以，但EA下单失败，可能是：");
               Print("  1. 交易上下文被其他操作占用（等待几秒后重试）");
               Print("  2. MT4版本或经纪商的特殊限制（联系经纪商）");
               Print("  3. EA执行频率过高导致服务器限制（降低InpCheckIntervalMs）");
               Print("【诊断】详细排查步骤请参考：错误133排查指南.md");
              }
            // 如果是错误 4109，提供详细的解决建议
            else if(error == 4109)
              {
               Print("【错误 4109 解决方案】");
               Print("  → 可能原因 1：交易手数不符合要求（检查最小/最大手数和手数步长）");
               Print("  → 可能原因 2：交易品种在当前时间不可交易或被限制");
               Print("  → 可能原因 3：账户权限或资金不足");
               Print("  → 可能原因 4：经纪商要求必须设置止损/止盈");
               Print("  → 建议：检查 EA 参数设置，特别是手数（InpLots）和交易品种（InpSymbol）");
               Print("  → 建议：尝试手动下一个卖单，如果也失败，联系经纪商");
              }
           }
         else
           {
            Print("【开空成功】Ticket=", ticket, " Lots=", lots, " Price=", bidPrice);
            // 开仓成功，写入确认文件
            WriteCommandAck(cmdLine);
            g_lastExecutedCommand = cmdLine; // 记录已执行的指令
            
            // ==== 严格保护：A和B必须同时成功，不能等待；若不成功，则本次开仓失败 ====
            // 等待文件写入完成（给文件系统时间刷新）
            Sleep(50);
            
            // 多次检查，增加检测成功率（最多检查5次，每次等待200ms，总共最多等待1秒）
            bool otherSideSucceeded = false;
            bool otherSideFailed = false;
            
            for(int checkRetry = 0; checkRetry < 5; checkRetry++)
              {
               if(checkRetry > 0)
                 {
                  Sleep(200); // 每次等待200ms
                 }
               
               // 检查另一边是否成功
               if(CheckOtherSideSucceeded(cmdLine))
                 {
                  otherSideSucceeded = true;
                  Print("【严格保护】检测到另一边也已成功开仓，两边同时成功，保留持仓（检查次数=", checkRetry + 1, "，等待时间=", checkRetry * 200, "ms）");
                  break;
                 }
               // 检查另一边是否失败
               else if(CheckOtherSideFailed(cmdLine))
                 {
                  otherSideFailed = true;
                  Print("【严格保护】检测到另一边开仓失败，本次开仓失败，立即平掉本端已开的仓位！（检查次数=", checkRetry + 1, "，等待时间=", checkRetry * 200, "ms）");
                  break;
                 }
               else
                 {
                  // 继续等待和检查
                  Print("【严格保护】检查次数=", checkRetry + 1, "，另一边尚未确认，继续等待...");
                 }
              }
            
            // 如果多次检查后，另一边既没有成功也没有失败，认为本次开仓失败
            if(!otherSideSucceeded && !otherSideFailed)
              {
               Print("【严格保护】1秒后另一边仍未成功确认，本次开仓失败，立即平掉本端已开的仓位！");
               Print("  → A和B必须同时成功，本次开仓失败，具备条件后再重新开仓");
              }
            
            // 如果另一边没有成功，立即平仓（本次开仓失败）
            if(!otherSideSucceeded)
              {
               Print("【严格保护】A和B必须同时成功，本次开仓失败，立即平掉本端已开的仓位！");
               // 立即平掉本端所有持仓（带重试机制）
               CloseAllMyPositionsWithRetry();
               // 验证是否真的平掉了
               if(HaveOpenHedgePositions())
                 {
                  Print("【严格保护-警告】平仓后仍有持仓，继续重试平仓...");
                  Sleep(300);
                  CloseAllMyPositionsWithRetry();
                  // 再次验证
                  if(HaveOpenHedgePositions())
                    {
                     Print("【严格保护-严重警告】平仓失败，仍有持仓！请手动检查！");
                    }
                 }
               // 清除确认，让主控知道本端已经平仓
               WriteCommandAck("FAILED:" + cmdLine);
              }
           }
        }
      else
        {
         // 本终端不是指令中的 longBroker 或 shortBroker，不需要执行
         Print("【跳过开仓】指令中的 Broker 不是本终端：longBroker=", longBroker, " shortBroker=", shortBroker, " 本终端=", InpBrokerId);
         // 但也要标记为已处理，避免重复检查
         g_lastExecutedCommand = cmdLine;
        }
     }
   else if(action == "CLOSEALL")
     {
      // 检查是否有持仓需要平仓
      bool hasPositions = HaveOpenHedgePositions();
      
      // 如果没有持仓，直接确认成功（可能已经被手动平仓了）
      if(!hasPositions)
        {
         WriteCommandAck(cmdLine);
         Print("【平仓确认】本终端没有持仓，已确认平仓指令");
         g_lastExecutedCommand = cmdLine; // 记录已执行的指令
         return;
        }
      
      // 有持仓，尝试平仓
      bool allClosed = true; // 假设全部平仓成功
      int closedCount = 0;   // 成功平仓的数量
      int failedCount = 0;   // 平仓失败的数量
      
      // 仅关闭本 EA、自身品种的所有仓位
      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
        if(OrderSymbol() != InpTradeSymbol)
            continue;
         if(OrderMagicNumber() != InpMagic)
            continue;

         int type = OrderType();
         double lots = OrderLots();
         int ticket = OrderTicket();
         bool   closed = false;
         
         // 交易前检查
         if(!IsTradeAllowed())
           {
            Print("【平仓失败】交易被禁止 - ticket=", ticket);
            allClosed = false;
            failedCount++;
            continue;
           }
         
         if(IsTradeContextBusy())
           {
            Print("【平仓失败】交易上下文繁忙 - ticket=", ticket);
            allClosed = false;
            failedCount++;
            continue;
           }
         
         if(type == OP_BUY)
           {
            closed = OrderClose(ticket, lots, Bid, InpSlippage, clrYellow);
           }
         else if(type == OP_SELL)
           {
            closed = OrderClose(ticket, lots, Ask, InpSlippage, clrYellow);
           }

         if(!closed)
           {
            int error = GetLastError();
            Print("【平仓失败】ticket=", ticket, " 错误代码=", error, " (", GetErrorDescription(error), ")");
            allClosed = false;
            failedCount++;
           }
         else
           {
            Print("【平仓成功】ticket=", ticket);
            closedCount++;
           }
        }
      
      // 根据平仓结果写入确认
      if(allClosed && closedCount > 0)
        {
         // 所有持仓都成功平仓
         WriteCommandAck(cmdLine);
         Print("【平仓确认】所有持仓已成功平仓，共 ", closedCount, " 单");
         g_lastExecutedCommand = cmdLine; // 记录已执行的指令
        }
      else if(failedCount > 0)
        {
         // 有平仓失败的，写入失败确认（不清除指令，继续重试）
         WriteCommandAck("FAILED:" + cmdLine);
         Print("【平仓确认】部分平仓失败：成功 ", closedCount, " 单，失败 ", failedCount, " 单，将继续重试");
         // 不设置 g_lastExecutedCommand，允许下次继续尝试平仓
        }
     }
  }

//+------------------------------------------------------------------+
//| 写入指令确认文件（执行成功后调用）                                |
//+------------------------------------------------------------------+
void WriteCommandAck(const string cmdLine)
  {
   string fileName = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_" + InpBrokerId + ".txt";
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      FileWriteString(handle, cmdLine); // 写入已执行的指令
      FileClose(handle);
     }
  }

//+------------------------------------------------------------------+
//| 检查两个终端是否都已执行指令（主控端调用）                        |
//+------------------------------------------------------------------+
bool CheckBothAcked(const string cmdLine)
  {
   string fileA = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_A.txt";
   string fileB = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_B.txt";
   
   bool ackedA = false, ackedB = false;
   bool failedA = false, failedB = false;
   
   // 检查 A 的确认
   int ha = FileOpen(fileA, FILE_TXT | FILE_READ | FILE_COMMON);
   if(ha != INVALID_HANDLE)
     {
      string ackLine = FileReadString(ha);
      FileClose(ha);
      if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedA = true;
      else if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedA = true;
     }
   
   // 检查 B 的确认
   int hb = FileOpen(fileB, FILE_TXT | FILE_READ | FILE_COMMON);
   if(hb != INVALID_HANDLE)
     {
      string ackLine = FileReadString(hb);
      FileClose(hb);
      if(StringCompare(ackLine, cmdLine, false) == 0)
         ackedB = true;
      else if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
         failedB = true;
     }
   
   // 如果有一边失败，返回 false（不清理指令，让另一边有机会重试或平仓）
   if(failedA || failedB)
     {
      Print("【警告】检测到一边开仓失败：A=", (failedA ? "失败" : (ackedA ? "成功" : "未确认")), 
            " B=", (failedB ? "失败" : (ackedB ? "成功" : "未确认")));
      return(false);
     }
   
   return(ackedA && ackedB);
  }

//+------------------------------------------------------------------+
//| 清除指令文件（主控端确认两个终端都执行成功后调用）                |
//+------------------------------------------------------------------+
void ClearCommandFile()
  {
   string fileName = GetStateFileName();
   int handle = FileOpen(fileName, FILE_TXT | FILE_WRITE | FILE_COMMON);
   if(handle != INVALID_HANDLE)
     {
      FileWriteString(handle, ""); // 写入空字符串，清除指令
      FileClose(handle);
     }
  }

//+------------------------------------------------------------------+
//| 检查另一边是否失败（用于开仓成功后的保护）                        |
//+------------------------------------------------------------------+
bool CheckOtherSideFailed(const string cmdLine)
  {
   string otherBrokerId = "";
   if(StringCompare(InpBrokerId, "A", false) == 0)
      otherBrokerId = "B";
   else if(StringCompare(InpBrokerId, "B", false) == 0)
      otherBrokerId = "A";
   else
      return(false); // 未知的 BrokerId

   string ackFile = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_" + otherBrokerId + ".txt";
   int handle = FileOpen(ackFile, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
      return(false); // 文件不存在，说明另一边还没执行

   string ackLine = FileReadString(handle);
   FileClose(handle);

   // 检查是否是失败确认
   if(StringFind(ackLine, "FAILED:") == 0 && StringFind(ackLine, cmdLine) > 0)
      return(true);

   return(false);
  }

//+------------------------------------------------------------------+
//| 检查另一边是否成功（用于开仓失败后的保护）                        |
//+------------------------------------------------------------------+
bool CheckOtherSideSucceeded(const string cmdLine)
  {
   string otherBrokerId = "";
   if(StringCompare(InpBrokerId, "A", false) == 0)
      otherBrokerId = "B";
   else if(StringCompare(InpBrokerId, "B", false) == 0)
      otherBrokerId = "A";
   else
      return(false); // 未知的 BrokerId

   string ackFile = g_stateFilePrefix + "CommandAck_" + InpSymbol + "_" + otherBrokerId + ".txt";
   int handle = FileOpen(ackFile, FILE_TXT | FILE_READ | FILE_COMMON);
   if(handle == INVALID_HANDLE)
      return(false); // 文件不存在，说明另一边还没执行

   string ackLine = FileReadString(handle);
   FileClose(handle);

   // 检查是否是成功确认（完全匹配指令）
   if(StringCompare(ackLine, cmdLine, false) == 0)
      return(true);

   return(false);
  }

//+------------------------------------------------------------------+
//| 立即平掉本端所有持仓（用于严格保护机制）                          |
//+------------------------------------------------------------------+
void CloseAllMyPositions()
  {
   int closedCount = 0;
   int failedCount = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != InpTradeSymbol)
         continue;
      if(OrderMagicNumber() != InpMagic)
         continue;

      int    ticket = OrderTicket();
      int    type   = OrderType();
      double lots   = OrderLots();
      bool   closed = false;

      if(type == OP_BUY)
        {
         double bid = MarketInfo(InpTradeSymbol, MODE_BID);
         closed = OrderClose(ticket, lots, bid, InpSlippage, clrYellow);
        }
      else if(type == OP_SELL)
        {
         double ask = MarketInfo(InpTradeSymbol, MODE_ASK);
         closed = OrderClose(ticket, lots, ask, InpSlippage, clrYellow);
        }

      if(closed)
        {
         Print("【严格保护-平仓】成功平掉仓位：ticket=", ticket, " symbol=", InpTradeSymbol);
         closedCount++;
        }
      else
        {
         int err = GetLastError();
         Print("【严格保护-平仓】失败：ticket=", ticket, " 错误代码=", err);
         failedCount++;
         ResetLastError();
        }
     }

   Print("【严格保护-平仓】完成：成功 ", closedCount, " 单，失败 ", failedCount, " 单");
  }

//+------------------------------------------------------------------+
//| 立即平掉本端所有持仓（带重试机制，用于严格保护）                    |
//+------------------------------------------------------------------+
void CloseAllMyPositionsWithRetry()
  {
   int maxRetries = 3;
   for(int retry = 0; retry < maxRetries; retry++)
     {
      if(retry > 0)
        {
         Sleep(200); // 每次重试前等待200ms
         Print("【严格保护-平仓重试】第 ", retry + 1, " 次尝试平仓...");
        }
      
      int closedCount = 0;
      int failedCount = 0;
      bool hasPositions = false;

      for(int i = OrdersTotal() - 1; i >= 0; i--)
        {
         if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
            continue;
         if(OrderSymbol() != InpTradeSymbol)
            continue;
         if(OrderMagicNumber() != InpMagic)
            continue;

         hasPositions = true;
         int    ticket = OrderTicket();
         int    type   = OrderType();
         double lots   = OrderLots();
         bool   closed = false;

         // 刷新报价
         RefreshRates();
         
         if(type == OP_BUY)
           {
            double bid = MarketInfo(InpTradeSymbol, MODE_BID);
            if(bid > 0)
               closed = OrderClose(ticket, lots, bid, InpSlippage, clrYellow);
           }
         else if(type == OP_SELL)
           {
            double ask = MarketInfo(InpTradeSymbol, MODE_ASK);
            if(ask > 0)
               closed = OrderClose(ticket, lots, ask, InpSlippage, clrYellow);
           }

         if(closed)
           {
            Print("【严格保护-平仓重试】成功平掉仓位：ticket=", ticket, " symbol=", InpTradeSymbol);
            closedCount++;
           }
         else
           {
            int err = GetLastError();
            Print("【严格保护-平仓重试】失败：ticket=", ticket, " 错误代码=", err);
            failedCount++;
            ResetLastError();
           }
        }
      
      // 如果没有持仓了，退出重试循环
      if(!hasPositions)
        {
         Print("【严格保护-平仓重试】所有持仓已平掉");
         return;
        }
      
      // 如果所有持仓都成功平掉，退出重试循环
      if(failedCount == 0 && closedCount > 0)
        {
         Print("【严格保护-平仓重试】所有持仓已成功平掉");
         return;
        }
     }
   
   Print("【严格保护-平仓重试】重试 ", maxRetries, " 次后，仍有部分持仓未能平掉");
  }

//+------------------------------------------------------------------+
//| 获取错误代码的详细描述                                            |
//+------------------------------------------------------------------+
string GetErrorDescription(int errorCode)
  {
   switch(errorCode)
     {
      case 0:     return "无错误";
      case 1:     return "无错误，但结果未知";
      case 2:     return "一般错误";
      case 3:     return "无效参数";
      case 4:     return "交易服务器繁忙";
      case 5:     return "旧版本的客户端终端";
      case 6:     return "与交易服务器无连接";
      case 7:     return "没有权限";
      case 8:     return "请求太频繁";
      case 9:     return "无效操作挂单";
      case 64:    return "账户被锁定";
      case 65:    return "无效账户";
      case 128:   return "交易超时";
      case 129:   return "无效价格";
      case 130:   return "无效止损";
      case 131:   return "无效交易量";
      case 132:   return "市场关闭";
      case 133:   return "交易被禁止";
      case 134:   return "没有足够的钱";
      case 135:   return "价格改变";
      case 136:   return "没有报价";
      case 137:   return "经纪商忙";
      case 138:   return "重新报价";
      case 139:   return "订单被锁定";
      case 140:   return "只允许买入";
      case 141:   return "请求太多";
      case 145:   return "修改被拒绝，订单太接近市场";
      case 146:   return "交易子系统忙";
      case 147:   return "使用到期日期的挂单被经纪商禁止";
      case 148:   return "挂单数量达到经纪商允许的上限";
      case 4109:  return "无效的交易参数（可能是止损/止盈距离、手数、或交易品种限制）";
      default:    return "未知错误";
     }
  }

//+------------------------------------------------------------------+
//| 结束                                                              |
//+------------------------------------------------------------------+


